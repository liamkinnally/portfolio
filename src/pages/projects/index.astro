---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectHeadings from '../../components/ProjectHeadings.astro';

const projects = [
  {
    title: 'League Match Analysis',
    area: 'Full-stack development · data visualization · testing',
    description: 'Reviewing how a League of Legends match developed. Compare two champions’ gold, creep score, and experience over time, then inspect recorded events within a selected interval.',
    detail: 'Explore live match data or try the built-in synthetic sample. Missing source data stays visibly unavailable.',
    tags: ['Java', 'Spring Boot', 'TypeScript', 'Next.js / React', 'PostgreSQL', 'Docker'],
    href: '/projects/league-match-analysis',
    source: 'https://github.com/liamkinnally/league-match-analysis',
    demo: 'https://lolmatchanalysis.app',
  },
  {
    title: 'NBA Player Stat Prediction',
    area: 'Machine learning · data engineering · testing',
    description: 'Predicting NBA points, assists, and rebounds from information available before tipoff. A Python pipeline with chronological evaluation, leakage-safe features, and a simple baseline to measure against.',
    detail: 'The points model beat the rolling-average baseline in 23 of 28 trailing seven-day windows, with a small overall improvement.',
    tags: ['Python', 'pandas', 'scikit-learn', 'SQLAlchemy', 'SQLite', 'pytest'],
    href: '/projects/nba-scoring-model',
    source: 'https://github.com/liamkinnally/nba-scoring-model',
  },
];
---

<BaseLayout title="Projects — Liam Kinnally" description="Software projects by Liam Kinnally: a full-stack League of Legends match analysis app and an NBA prediction pipeline.">
  <div class="project-page container-shell pt-28 pb-24 sm:pt-32">
    <header class="max-w-3xl">
      <div class="eyebrow">Selected work</div>
      <h1 class="scroll-heading-shine gradient-text mt-6 text-5xl font-[780] leading-[1.02] tracking-[-0.05em] sm:text-6xl" data-scroll-heading data-shine-text="Projects">Projects</h1>
      <p class="project-body-copy mt-7 text-lg leading-8 text-slate-300 sm:text-xl">Software for exploring sports and game data, with attention to how it is collected, tested, and presented.</p>
    </header>

    <div class="mt-14 space-y-6">
      {projects.map((project) => (
        <article class="scroll-frame-focus scroll-frame-major glass-card rounded-2xl p-6 sm:p-8 lg:p-10">
          <div class="grid gap-7 lg:grid-cols-[1.15fr_0.85fr] lg:gap-12">
            <div>
              <div class="eyebrow">{project.area}</div>
              <h2 class="mt-5 text-2xl font-bold tracking-[-0.03em] sm:text-3xl"><a href={project.href} class="transition hover:text-[var(--link-hover-accent)]">{project.title}</a></h2>
              <p class="project-body-copy mt-5 leading-7 text-slate-300">{project.description}</p>
            </div>
            <div class="flex flex-col justify-between gap-6">
              <div class="flex flex-wrap gap-2">{project.tags.map((tag) => <span class="kbd-tag">{tag}</span>)}</div>
              <p class="project-body-copy leading-7 text-slate-300">{project.detail}</p>
            </div>
          </div>
          <div class="mt-8 flex flex-wrap items-center gap-5 text-sm font-semibold">
            <a href={project.href} class="button-primary" aria-label={`Explore ${project.title}`}>Explore project <span aria-hidden="true">→</span></a>
            {project.demo && <a href={project.demo} target="_blank" rel="noreferrer" class="button-secondary" aria-label={`${project.title} live demo`}>Live demo <span aria-hidden="true">↗</span></a>}
            <a href={project.source} target="_blank" rel="noreferrer" class="text-slate-300 transition hover:text-white" aria-label={`${project.title} source on GitHub`}>Source <span aria-hidden="true">↗</span></a>
          </div>
        </article>
      ))}
    </div>
  </div>
  <ProjectHeadings />
</BaseLayout>
