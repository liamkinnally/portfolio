---
const sourceUrl = 'https://raw.githubusercontent.com/liamkinnally/nba-scoring-model/main/reports/data/holdout_predictions.csv';
const response = await fetch(sourceUrl);
if (!response.ok) {
  throw new Error(`Could not load holdout prediction data (${response.status})`);
}

const csv = await response.text();
const lines = csv.trim().split(/\r?\n/);
const header = lines[0].split(',');
const targetIndex = header.indexOf('target');
const actualIndex = header.indexOf('actual');
const predictionIndex = header.indexOf('model_pred');

if ([targetIndex, actualIndex, predictionIndex].some((index) => index < 0)) {
  throw new Error('Holdout prediction CSV is missing expected columns.');
}

const points = lines.slice(1).flatMap((line) => {
  const cells = line.split(',');
  if (cells[targetIndex] !== 'points') return [];
  const actual = Number(cells[actualIndex]);
  const predicted = Number(cells[predictionIndex]);
  if (!Number.isFinite(actual) || !Number.isFinite(predicted)) return [];
  return [{ actual, predicted }];
});

const width = 760;
const height = 470;
const margin = { top: 30, right: 30, bottom: 58, left: 58 };
const plotWidth = width - margin.left - margin.right;
const plotHeight = height - margin.top - margin.bottom;
const observedMax = Math.max(...points.flatMap((point) => [point.actual, point.predicted]));
const axisMax = Math.max(60, Math.ceil(observedMax / 10) * 10);
const ticks = Array.from({ length: axisMax / 10 + 1 }, (_, index) => index * 10);
const binCount = Math.round(axisMax / 2);
const cellWidth = plotWidth / binCount;
const cellHeight = plotHeight / binCount;
const bins = new Map<string, { x: number; y: number; count: number; actualSum: number; predictedSum: number }>();

for (const point of points) {
  const bx = Math.min(binCount - 1, Math.max(0, Math.floor((point.actual / axisMax) * binCount)));
  const by = Math.min(binCount - 1, Math.max(0, Math.floor((point.predicted / axisMax) * binCount)));
  const key = `${bx}:${by}`;
  const existing = bins.get(key);
  if (existing) {
    existing.count += 1;
    existing.actualSum += point.actual;
    existing.predictedSum += point.predicted;
  } else {
    bins.set(key, {
      x: bx,
      y: by,
      count: 1,
      actualSum: point.actual,
      predictedSum: point.predicted,
    });
  }
}

const density = [...bins.values()];
const maxCount = Math.max(...density.map((bin) => bin.count));
const x = (value: number) => margin.left + (value / axisMax) * plotWidth;
const y = (value: number) => margin.top + plotHeight - (value / axisMax) * plotHeight;
const maxPrediction = Math.max(...points.map((point) => point.predicted));
const maxActual = Math.max(...points.map((point) => point.actual));
---

<div class="chart-shell scroll-frame-focus scroll-frame-quiet scroll-frame-clipped" data-prediction-quality-chart>
  <div class="flex flex-col gap-4 px-5 pt-5 sm:flex-row sm:items-start sm:justify-between sm:px-6 sm:pt-6">
    <div>
      <div class="text-[0.7rem] font-bold uppercase tracking-[0.16em] text-slate-400">Chronological holdout · points</div>
      <h3
        class="scroll-heading-shine mt-2 text-base font-semibold tracking-[-0.015em] text-slate-100 sm:text-lg"
        data-scroll-heading
        data-shine-text="Actual vs. predicted"
      >Actual vs. predicted</h3>
    </div>
    <div class="flex flex-wrap gap-2 self-start">
      <span class="interactive-pill rounded-full border border-blue-300/15 bg-blue-300/[0.06] px-3 py-1.5 text-xs font-semibold text-blue-200">{points.length.toLocaleString()} rows</span>
      <span class="interactive-pill rounded-full border border-white/[0.08] bg-white/[0.025] px-3 py-1.5 text-xs font-semibold text-slate-300">2-point density cells</span>
    </div>
  </div>

  <div class="mt-2 flex flex-wrap gap-x-5 gap-y-2 px-5 text-xs text-slate-400 sm:px-6">
    <span class="inline-flex items-center gap-2"><span class="h-2.5 w-2.5 rounded-[3px] bg-[#82adff] opacity-80"></span>More observations = brighter</span>
    <span class="inline-flex items-center gap-2"><span class="h-0 w-5 border-t border-dashed border-slate-400"></span>Perfect prediction</span>
  </div>

  <div class="mt-1 px-2 pb-2 sm:px-3 sm:pb-3">
    <svg class="block h-auto w-full" viewBox={`0 0 ${width} ${height}`} role="img" aria-labelledby="quality-title quality-desc">
      <title id="quality-title">Actual versus predicted points on the chronological holdout</title>
      <desc id="quality-desc">All points-model holdout observations are aggregated into two-point density cells. The model shows useful predictive signal but compresses extreme scoring outcomes toward more typical values.</desc>
      <defs>
        <linearGradient id="density-fill" x1="0" y1="1" x2="1" y2="0">
          <stop offset="0%" stop-color="#6895ef" />
          <stop offset="100%" stop-color="#987be6" />
        </linearGradient>
        <filter id="density-glow" x="-25%" y="-25%" width="150%" height="150%">
          <feGaussianBlur stdDeviation="3" result="blur" />
          <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
        </filter>
        <filter id="density-hover-glow" x="-80%" y="-80%" width="260%" height="260%">
          <feGaussianBlur stdDeviation="2.4" result="hoverBlur" />
          <feMerge><feMergeNode in="hoverBlur"/><feMergeNode in="SourceGraphic"/></feMerge>
        </filter>
        <filter id="density-tooltip-shadow" x="-30%" y="-30%" width="160%" height="180%">
          <feDropShadow dx="0" dy="4" stdDeviation="5" flood-color="#020617" flood-opacity="0.5" />
        </filter>
      </defs>

      <rect x={margin.left} y={margin.top} width={plotWidth} height={plotHeight} rx="14" fill="var(--chart-plot-bg)" />

      {ticks.map((tick) => (
        <g>
          <line x1={x(tick)} x2={x(tick)} y1={margin.top} y2={margin.top + plotHeight} stroke="var(--chart-grid)" stroke-width="1" />
          <line x1={margin.left} x2={margin.left + plotWidth} y1={y(tick)} y2={y(tick)} stroke="var(--chart-grid)" stroke-width="1" />
          <text x={x(tick)} y={margin.top + plotHeight + 27} text-anchor="middle" fill="var(--chart-label)" font-size="11" font-weight="600">{tick}</text>
          <text x={margin.left - 12} y={y(tick) + 4} text-anchor="end" fill="var(--chart-label)" font-size="11" font-weight="600">{tick}</text>
        </g>
      ))}

      <g class="density-layer">
      {density.map((bin) => {
        const intensity = Math.sqrt(bin.count / maxCount);
        const baseOpacity = 0.10 + intensity * 0.78;

        return (
          <rect
            class="density-cell"
            x={margin.left + bin.x * cellWidth + 0.7}
            y={margin.top + plotHeight - (bin.y + 1) * cellHeight + 0.7}
            width={Math.max(1, cellWidth - 1.4)}
            height={Math.max(1, cellHeight - 1.4)}
            rx="1.8"
            fill="url(#density-fill)"
            opacity={baseOpacity}
            filter={intensity > 0.72 ? 'url(#density-glow)' : undefined}
          />
        );
      })}

      </g>

      <line x1={x(0)} y1={y(0)} x2={x(axisMax)} y2={y(axisMax)} stroke="var(--chart-reference)" stroke-width="1.6" stroke-dasharray="7 7" opacity="0.70" />

      {density.map((bin) => {
        const cellX = margin.left + bin.x * cellWidth + 0.7;
        const cellY = margin.top + plotHeight - (bin.y + 1) * cellHeight + 0.7;
        const visibleCellWidth = Math.max(1, cellWidth - 1.4);
        const visibleCellHeight = Math.max(1, cellHeight - 1.4);
        const centerX = cellX + visibleCellWidth / 2;
        const centerY = cellY + visibleCellHeight / 2;
        const tooltipWidth = 166;
        const tooltipHeight = 88;
        const tooltipGap = 12;
        const tooltipX = centerX < margin.left + plotWidth / 2
          ? Math.min(centerX + tooltipGap, margin.left + plotWidth - tooltipWidth - 8)
          : Math.max(centerX - tooltipWidth - tooltipGap, margin.left + 8);
        const tooltipY = centerY < margin.top + tooltipHeight + 24
          ? Math.min(centerY + tooltipGap, margin.top + plotHeight - tooltipHeight - 8)
          : Math.max(centerY - tooltipHeight - tooltipGap, margin.top + 8);
        const actualMean = bin.actualSum / bin.count;
        const predictedMean = bin.predictedSum / bin.count;
        const delta = predictedMean - actualMean;
        const difference = Math.abs(delta);
        const resultLabel = difference < 0.15
          ? 'Near parity'
          : `${delta < 0 ? 'Underpredicted' : 'Overpredicted'} by ${difference.toFixed(1)} pts`;

        return (
          <g class="density-hover-group">
            <rect
              class="density-hover-hit"
              x={cellX - 1.5}
              y={cellY - 1.5}
              width={visibleCellWidth + 3}
              height={visibleCellHeight + 3}
              rx="3"
              fill="transparent"
            />
            <line class="density-hover-guide" x1={centerX} x2={centerX} y1={centerY} y2={margin.top + plotHeight} />
            <line class="density-hover-guide" x1={margin.left} x2={centerX} y1={centerY} y2={centerY} />
            <rect
              class="density-hover-cell"
              x={cellX}
              y={cellY}
              width={visibleCellWidth}
              height={visibleCellHeight}
              rx="1.8"
            />
            <g class="density-hover-tooltip" transform={`translate(${tooltipX}, ${tooltipY})`}>
              <rect class="density-hover-tooltip-box" width={tooltipWidth} height={tooltipHeight} rx="9" filter="url(#density-tooltip-shadow)" />
              <text class="density-hover-tooltip-title" x="10" y="17">2-point density cell</text>
              <text class="density-hover-tooltip-label" x="10" y="36">Actual avg</text>
              <text class="density-hover-tooltip-value" x={tooltipWidth - 10} y="36" text-anchor="end">{actualMean.toFixed(1)}</text>
              <text class="density-hover-tooltip-label" x="10" y="52">Predicted avg</text>
              <text class="density-hover-tooltip-value density-hover-tooltip-value--predicted" x={tooltipWidth - 10} y="52" text-anchor="end">{predictedMean.toFixed(1)}</text>
              <text class="density-hover-tooltip-label" x="10" y="68">Observations</text>
              <text class="density-hover-tooltip-value" x={tooltipWidth - 10} y="68" text-anchor="end">{bin.count}</text>
              <text class:list={['density-hover-tooltip-result', delta < -0.15 ? 'density-hover-tooltip-result--under' : delta > 0.15 ? 'density-hover-tooltip-result--over' : 'density-hover-tooltip-result--parity']} x="10" y="82">{resultLabel}</text>
            </g>
          </g>
        );
      })}

      <text x={margin.left + plotWidth / 2} y={height - 8} text-anchor="middle" fill="var(--chart-axis)" font-size="10.5" font-weight="600">Actual points</text>
      <text x="15" y={margin.top + plotHeight / 2} text-anchor="middle" fill="var(--chart-axis)" font-size="10.5" font-weight="600" transform={`rotate(-90 15 ${margin.top + plotHeight / 2})`}>Predicted points</text>
    </svg>
  </div>

  <div class="mx-5 mb-5 grid gap-2 border-t border-white/[0.07] pt-4 text-sm leading-6 sm:mx-6 sm:mb-6 sm:grid-cols-[1fr_auto] sm:items-center">
    <span class="text-slate-400">Typical outcomes track the parity line; high-scoring games fall below it as predictions compress toward the mean.</span>
    <span class="shrink-0 font-semibold text-blue-200">Max: {maxPrediction.toFixed(1)} predicted · {maxActual.toFixed(0)} actual</span>
  </div>
</div>

<script>
  (() => {
    const coarsePointer = window.matchMedia('(hover: none) and (pointer: coarse)').matches;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    document.querySelectorAll<HTMLElement>('[data-prediction-quality-chart]').forEach((chart) => {
      if (!coarsePointer || reducedMotion || !('IntersectionObserver' in window)) {
        chart.classList.add('density-in-view');
        return;
      }

      const observer = new IntersectionObserver((entries) => {
        const entry = entries[0];
        if (!entry?.isIntersecting) return;

        requestAnimationFrame(() => chart.classList.add('density-in-view'));
        observer.disconnect();
      }, {
        threshold: 0.16,
        rootMargin: '0px 0px -8% 0px',
      });

      observer.observe(chart);
    });
  })();
</script>

<style>
  .chart-shell {
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 1rem;
    background: var(--chart-shell-bg);
    box-shadow: var(--chart-shadow);
  }

  .density-cell {
    transform-box: fill-box;
    transform-origin: center;
    animation: density-in 420ms ease both;
  }

  .density-hover-guide,
  .density-hover-cell,
  .density-hover-tooltip {
    opacity: 0;
    pointer-events: none;
  }

  .density-hover-guide {
    stroke: var(--chart-label);
    stroke-width: 1;
    stroke-dasharray: 3 5;
    vector-effect: non-scaling-stroke;
  }

  .density-hover-cell {
    fill: none;
    stroke: #b9d0ff;
    stroke-width: 1.5;
    transform-box: fill-box;
    transform-origin: center;
    transform: scale(0.94);
    vector-effect: non-scaling-stroke;
    filter: url(#density-hover-glow);
  }

  .density-hover-tooltip-box {
    fill: #0b1324;
    fill-opacity: 0.96;
    stroke: rgba(148, 163, 184, 0.24);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .density-hover-tooltip-title {
    fill: #e2e8f0;
    font-size: 10.5px;
    font-weight: 700;
  }

  .density-hover-tooltip-label {
    fill: #94a3b8;
    font-size: 9.5px;
    font-weight: 600;
  }

  .density-hover-tooltip-value {
    fill: #cbd5e1;
    font-size: 9.5px;
    font-weight: 700;
  }

  .density-hover-tooltip-value--predicted {
    fill: #9fc0ff;
  }

  .density-hover-tooltip-result {
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.01em;
  }

  .density-hover-tooltip-result--under {
    fill: #93b7ff;
  }

  .density-hover-tooltip-result--over,
  .density-hover-tooltip-result--parity {
    fill: #aeb8c7;
  }

  @media (hover: hover) and (pointer: fine) {
    .density-cell {
      transition: transform 300ms ease-out;
    }

    .density-hover-guide {
      transition: opacity 140ms ease;
    }

    .density-hover-cell {
      transition: opacity 140ms ease, transform 160ms ease;
    }

    .density-hover-tooltip {
      transition: opacity 130ms ease;
    }

    .density-hover-group:hover .density-hover-guide {
      opacity: 0.28;
    }

    .density-hover-group:hover .density-hover-cell,
    .density-hover-group:hover .density-hover-tooltip {
      opacity: 1;
    }

    .density-hover-group:hover .density-hover-cell {
      transform: scale(1.16);
    }
  }

  @keyframes density-in {
    from { opacity: 0; transform: translateY(3px); }
  }

  @keyframes density-layer-in {
    from { opacity: 0; transform: translateY(3px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (hover: none) and (pointer: coarse) {
    .density-cell {
      animation: none;
      filter: none !important;
    }

    .density-layer {
      opacity: 0;
      transform: translateY(3px);
    }

    .chart-shell.density-in-view .density-layer {
      animation: density-layer-in 420ms cubic-bezier(.2,.7,.2,1) both;
    }

    .density-hover-group {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .density-cell {
      animation: none;
      transition: none;
    }

    .density-layer,
    .chart-shell.density-in-view .density-layer {
      animation: none;
      opacity: 1;
      transform: none;
    }

    .density-hover-guide,
    .density-hover-cell,
    .density-hover-tooltip {
      transition: none;
    }

    .density-hover-cell {
      transform: none;
    }
  }
</style>
