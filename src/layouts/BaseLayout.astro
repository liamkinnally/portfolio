---
import '../styles/global.css';
import '../styles/theme-overrides.css';
import '../styles/skill-interactions.css';
import '../styles/heading-interactions.css';
import Header from '../components/Header.astro';
import ParticleCanvas from '../components/ParticleCanvas.astro';
import SpeedInsights from '@vercel/speed-insights/astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Liam Kinnally — Software Engineering, Software Testing & AI/ML',
  description = 'Portfolio of Liam Kinnally, an Information Technology student at UCF focused on software engineering, software testing, and AI/ML.',
} = Astro.props;

const siteOrigin = Astro.site ?? Astro.url.origin;
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin);
const socialImage = new URL('/og-image.png', siteOrigin);
const socialImageAlt = 'Liam Kinnally — Software Engineering · Software Testing · AI / ML';
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <script is:inline>
      (() => {
        let theme = 'dark';
        try {
          if (localStorage.getItem('theme') === 'light') theme = 'light';
        } catch {}
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#07090d" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Liam Kinnally" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        const meta = document.querySelector('meta[name="theme-color"]');
        if (meta && document.documentElement.dataset.theme === 'light') {
          meta.setAttribute('content', '#f7f9fd');
        }
      })();
    </script>
  </head>
  <body>
    <ParticleCanvas />
    <Header />
    <main class="relative z-10">
      <slot />
    </main>
    <SpeedInsights />

    <script>
      const coarsePointer = window.matchMedia('(hover: none) and (pointer: coarse)').matches;
      const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (coarsePointer && !reducedMotion) {
        const selectors = [
          '.availability-pill.interactive-pill',
          '.scroll-frame-focus',
          '#work .metric-card',
          '#work .kbd-tag',
          '#skills .kbd-tag',
          '#education .kbd-tag',
          '.chart-shell--compact .interactive-pill',
          '.project-page .metric-card',
          '.project-page .stationary-highlight',
          '.project-page .interactive-pill',
        ];

        const deferredInitialSelectors = [
          '.availability-pill.interactive-pill',
          '.project-page header .kbd-tag',
        ];

        const targets = Array.from(
          document.querySelectorAll<HTMLElement>(
            [...selectors, ...deferredInitialSelectors].join(','),
          ),
        );
        targets.forEach((target) => target.classList.add('mobile-scroll-focus'));

        const deferredInitialTargets = new Set(
          Array.from(
            document.querySelectorAll<HTMLElement>(deferredInitialSelectors.join(',')),
          ),
        );
        const initialScrollY = window.scrollY;

        let scrollFrame = 0;
        let geometryObserver: ResizeObserver | null = null;
        let layoutRects = new Map<HTMLElement, DOMRect>();

        const clamp01 = (value: number) => Math.min(1, Math.max(0, value));
        const smoothstep = (value: number) => {
          const t = clamp01(value);
          return t * t * (3 - 2 * t);
        };

        const getViewportMotion = () => {
          const viewport = window.visualViewport;
          const viewportTop = viewport?.offsetTop ?? 0;
          const viewportHeight = viewport?.height ?? window.innerHeight;

          return {
            viewportTop,
            entryLine: viewportTop + viewportHeight * 0.80,
            releaseLine: viewportTop + viewportHeight * 0.20,
            viewportHeight,
          };
        };

        const getInlineBloomDistance = (viewportHeight: number) =>
          Math.min(108, Math.max(72, viewportHeight * 0.095));

        const getSystemStepBloomDistance = (viewportHeight: number) =>
          Math.min(122, Math.max(96, viewportHeight * 0.115));

        const isRollingMaeFrame = (target: HTMLElement) =>
          target.classList.contains('chart-shell') && !!target.querySelector('.mae-wins-pill');

        const isPredictionQualityFrame = (target: HTMLElement) =>
          target.classList.contains('chart-shell') &&
          !!target.querySelector('[data-shine-text="Actual vs. predicted"]');

        const isPredictionQualityPill = (target: HTMLElement) => {
          const frame = target.closest<HTMLElement>('.chart-shell');
          return !!frame && isPredictionQualityFrame(frame);
        };

        const isLingeringChartFrame = (target: HTMLElement) =>
          target.classList.contains('chart-shell') && !isRollingMaeFrame(target);

        const getFrameExitDistance = (
          viewportHeight: number,
          target: HTMLElement,
        ) => {
          if (isPredictionQualityFrame(target)) {
            return Math.min(190, Math.max(145, viewportHeight * 0.18));
          }

          if (isRollingMaeFrame(target) && target.closest('.project-page')) {
            return Math.min(210, Math.max(165, viewportHeight * 0.20));
          }

          if (isRollingMaeFrame(target)) {
            return Math.min(168, Math.max(120, viewportHeight * 0.17));
          }

          if (isLingeringChartFrame(target)) {
            return Math.min(250, Math.max(190, viewportHeight * 0.25));
          }

          const nestedFrames = target.querySelectorAll('.scroll-frame-focus').length;
          if (nestedFrames >= 5) {
            return Math.min(150, Math.max(112, viewportHeight * 0.15));
          }

          return Math.min(150, Math.max(104, viewportHeight * 0.14));
        };

        const getCachedRect = (target: HTMLElement) => {
          const cached = layoutRects.get(target);
          if (cached) return cached;
          const rect = target.getBoundingClientRect();
          layoutRects.set(target, rect);
          return rect;
        };

        const preloadLayoutRects = () => {
          layoutRects = new Map<HTMLElement, DOMRect>();

          for (const target of targets) {
            getCachedRect(target);

            if (!target.classList.contains('scroll-frame-focus')) continue;

            target
              .querySelectorAll<HTMLElement>('.scroll-frame-focus, .interactive-pill')
              .forEach((child) => getCachedRect(child));
          }
        };

        const getBloomDistance = (
          viewportHeight: number,
          elementHeight: number,
          target: HTMLElement,
        ) => {
          if (target.classList.contains('scroll-frame-focus')) {
            if (target.matches('#work .scroll-frame-major')) {
              return Math.min(500, Math.max(410, viewportHeight * 0.50));
            }

            const nestedFrames = Array.from(
              target.querySelectorAll<HTMLElement>('.scroll-frame-focus'),
            );

            if (nestedFrames.length >= 5) {
              const frameRect = getCachedRect(target);
              const lastStepCompletion = Math.max(
                ...nestedFrames.map((step) => {
                  const stepRect = getCachedRect(step);
                  const stepTopOffset = stepRect.top - frameRect.top;
                  return stepTopOffset + getSystemStepBloomDistance(viewportHeight);
                }),
              );
              const frameTail = Math.min(
                42,
                Math.max(28, viewportHeight * 0.038),
              );

              return Math.min(
                620,
                Math.max(180, lastStepCompletion + frameTail),
              );
            }

            const parentFrame = target.parentElement?.closest<HTMLElement>('.scroll-frame-focus');
            if (
              parentFrame &&
              parentFrame.querySelectorAll('.scroll-frame-focus').length >= 5
            ) {
              return getSystemStepBloomDistance(viewportHeight);
            }

            if (target.classList.contains('chart-shell')) {
              const frameRect = getCachedRect(target);
              const pills = Array.from(
                target.querySelectorAll<HTMLElement>('.interactive-pill'),
              );

              if (pills.length) {
                const lastPillCompletion = Math.max(
                  ...pills.map((pill) => {
                    const pillRect = getCachedRect(pill);
                    const pillCenterOffset =
                      pillRect.top + pillRect.height / 2 - frameRect.top;
                    return pillCenterOffset + getInlineBloomDistance(viewportHeight);
                  }),
                );
                const frameTail = Math.min(
                  36,
                  Math.max(24, viewportHeight * 0.035),
                );

                return Math.min(
                  280,
                  Math.max(112, lastPillCompletion + frameTail),
                );
              }
            }

            const animatedChildCount = target.querySelectorAll(
              '.kbd-tag, .metric-card, .interactive-pill',
            ).length;

            if (target.classList.contains('scroll-frame-quiet')) {
              const stableQuietDistance =
                viewportHeight * 0.07 +
                Math.min(animatedChildCount, 10) * 12 +
                25;
              return Math.min(175, Math.max(84, stableQuietDistance));
            }

            if (animatedChildCount === 0) {
              return Math.min(170, Math.max(112, viewportHeight * 0.15));
            }

            const stableFrameDistance =
              viewportHeight * 0.085 +
              Math.min(animatedChildCount, 10) * 16 +
              95;
            return Math.min(380, Math.max(112, stableFrameDistance));
          }

          return getInlineBloomDistance(viewportHeight);
        };

        const setBloom = (
          target: HTMLElement,
          strength: number,
          phase: 'entry' | 'active' | 'exit',
        ) => {
          const rawProgress = clamp01(strength);
          const borderProgress = smoothstep(rawProgress);
          const surfaceProgress = smoothstep(clamp01((rawProgress - 0.12) / 0.88));
          let clipTop = 0;
          let clipBottom = 0;

          if (phase === 'entry') {
            clipBottom = (1 - borderProgress) * 100;
          } else if (phase === 'exit') {
            clipTop = (1 - borderProgress) * 100;
          }

          target.style.setProperty('--mobile-bloom-strength', borderProgress.toFixed(4));
          target.style.setProperty('--mobile-surface-strength', surfaceProgress.toFixed(4));
          target.style.setProperty('--mobile-bloom-clip-top', `${clipTop.toFixed(2)}%`);
          target.style.setProperty('--mobile-bloom-clip-bottom', `${clipBottom.toFixed(2)}%`);
          target.classList.toggle('mobile-scroll-colored', surfaceProgress > 0.44);
        };

        const keepFrameWithDescendants = (
          target: HTMLElement,
          releaseAnchor: number,
          releaseLine: number,
        ) => {
          if (releaseAnchor > releaseLine) return;

          const descendantStrength = targets.reduce((strongest, child) => {
            if (child === target || !target.contains(child)) return strongest;
            const strength = Number(child.style.getPropertyValue('--mobile-bloom-strength')) || 0;
            return Math.max(strongest, strength);
          }, 0);

          const currentStrength = Number(
            target.style.getPropertyValue('--mobile-bloom-strength'),
          ) || 0;

          if (descendantStrength <= currentStrength) return;

          target.style.setProperty('--mobile-bloom-strength', descendantStrength.toFixed(4));
          target.style.setProperty('--mobile-surface-strength', '0');
          target.style.setProperty(
            '--mobile-bloom-clip-top',
            `${((1 - descendantStrength) * 100).toFixed(2)}%`,
          );
          target.style.setProperty('--mobile-bloom-clip-bottom', '0%');
        };

        const updateScrollHighlights = () => {
          scrollFrame = 0;
          const { viewportTop, entryLine, releaseLine, viewportHeight } = getViewportMotion();

          preloadLayoutRects();

          for (const target of targets) {
            const rect = getCachedRect(target);
            const center = rect.top + rect.height / 2;
            const isFrame = target.classList.contains('scroll-frame-focus');
            const isRollingChart = isFrame && isRollingMaeFrame(target);
            const isProjectRollingChart = isRollingChart && !!target.closest('.project-page');
            const isPredictionChart = isFrame && isPredictionQualityFrame(target);
            const isPredictionPill = !isFrame && isPredictionQualityPill(target);
            const isLingeringChart = isFrame && isLingeringChartFrame(target);
            const isEducationPill = target.matches('#education .kbd-tag');
            const isEducationFrame = isFrame && !!target.closest('#education');
            const isSkillPill = target.matches('#skills .kbd-tag');
            const isSkillFrame = isFrame && !!target.closest('#skills');
            const isFeaturedProjectPill = target.matches('#work .kbd-tag');
            const isFeaturedProjectFrame = isFrame && target.matches('#work .scroll-frame-major');
            const isBottomContactCard =
              isFrame &&
              target.classList.contains('scroll-frame-major') &&
              target.closest('section')?.previousElementSibling?.id === 'about';
            const entryAnchor = isFrame ? rect.top : center;
            const releaseAnchor =
              isProjectRollingChart ||
              isPredictionChart ||
              isLingeringChart ||
              isEducationFrame ||
              isFeaturedProjectFrame
                ? rect.bottom
                : isFrame
                  ? rect.top
                  : center;
            const defaultBloomDistance = getBloomDistance(viewportHeight, rect.height, target);
            const bloomDistance = isPredictionPill
              ? Math.min(86, Math.max(68, viewportHeight * 0.08))
              : defaultBloomDistance;
            const entryDistance = isEducationPill
              ? Math.min(78, Math.max(62, viewportHeight * 0.075))
              : isPredictionChart
                ? Math.min(170, Math.max(135, viewportHeight * 0.16))
                : bloomDistance;
            const targetEntryLine = isEducationPill
              ? viewportTop + viewportHeight * 0.985
              : isPredictionChart
                ? viewportTop + viewportHeight * 0.88
                : isPredictionPill
                  ? viewportTop + viewportHeight * 0.90
                  : isSkillFrame
                    ? viewportTop + viewportHeight * 0.91
                    : isFeaturedProjectFrame
                      ? viewportTop + viewportHeight * 0.88
                      : entryLine;
            const exitDistance = isEducationPill
              ? Math.min(88, Math.max(72, viewportHeight * 0.085))
              : isPredictionPill
                ? Math.min(92, Math.max(74, viewportHeight * 0.09))
                : isFrame
                  ? getFrameExitDistance(viewportHeight, target)
                  : bloomDistance;
            const targetReleaseLine = isEducationPill
              ? viewportTop + viewportHeight * 0.19
              : isEducationFrame
                ? viewportTop + viewportHeight * 0.52
                : isSkillPill
                  ? viewportTop + viewportHeight * 0.20
                  : isSkillFrame
                    ? viewportTop + viewportHeight * 0.14
                    : isFeaturedProjectPill
                      ? viewportTop + viewportHeight * 0.26
                      : isFeaturedProjectFrame
                        ? viewportTop + viewportHeight * 0.52
                        : isPredictionPill
                          ? viewportTop + viewportHeight * 0.14
                          : isProjectRollingChart
                            ? viewportTop + viewportHeight * 0.44
                            : isPredictionChart
                              ? viewportTop + viewportHeight * 0.36
                              : isRollingChart
                                ? viewportTop + viewportHeight * 0.10
                                : isLingeringChart
                                  ? viewportTop + viewportHeight * 0.48
                                  : releaseLine;

            if (deferredInitialTargets.has(target)) {
              const activationDistance = getInlineBloomDistance(viewportHeight);
              const scrollProgress = clamp01((window.scrollY - initialScrollY) / activationDistance);
              const deferredReleaseLine = target.matches('.availability-pill.interactive-pill')
                ? viewportTop + viewportHeight * 0.22
                : releaseLine;

              if (center > deferredReleaseLine) {
                setBloom(target, scrollProgress, scrollProgress < 1 ? 'entry' : 'active');
              } else {
                const exitProgress = clamp01(
                  (deferredReleaseLine - center) / activationDistance,
                );
                setBloom(target, Math.min(scrollProgress, 1 - exitProgress), 'exit');
              }
              continue;
            }

            if (entryAnchor > targetEntryLine) {
              setBloom(target, 0, 'entry');
              continue;
            }

            const entryEnd = targetEntryLine - entryDistance;
            if (entryAnchor > entryEnd) {
              const entryProgress = clamp01((targetEntryLine - entryAnchor) / entryDistance);
              setBloom(target, entryProgress, 'entry');
              continue;
            }

            if (isBottomContactCard) {
              setBloom(target, 1, 'active');
              continue;
            }

            if (releaseAnchor > targetReleaseLine) {
              setBloom(target, 1, 'active');
              continue;
            }

            const exitProgress = clamp01((targetReleaseLine - releaseAnchor) / exitDistance);
            setBloom(target, 1 - exitProgress, 'exit');
          }

          const exitingFrames = targets
            .filter((target) => target.classList.contains('scroll-frame-focus'))
            .sort(
              (a, b) =>
                a.querySelectorAll('.scroll-frame-focus').length -
                b.querySelectorAll('.scroll-frame-focus').length,
            );

          for (const target of exitingFrames) {
            const isBottomContactCard =
              target.classList.contains('scroll-frame-major') &&
              target.closest('section')?.previousElementSibling?.id === 'about';
            const isProjectRollingChart =
              isRollingMaeFrame(target) && !!target.closest('.project-page');
            const isPredictionChart = isPredictionQualityFrame(target);
            const isEducationFrame = !!target.closest('#education');
            const isFeaturedProjectFrame = target.matches('#work .scroll-frame-major');
            const isSkillFrame = !!target.closest('#skills');

            if (
              isBottomContactCard ||
              isProjectRollingChart ||
              isPredictionChart ||
              isEducationFrame ||
              isFeaturedProjectFrame
            ) continue;

            const rect = getCachedRect(target);
            const lingeringChart = isLingeringChartFrame(target);
            const rollingChart = isRollingMaeFrame(target);
            const releaseAnchor = lingeringChart ? rect.bottom : rect.top;
            const targetReleaseLine = isSkillFrame
              ? viewportTop + viewportHeight * 0.14
              : rollingChart
                ? viewportTop + viewportHeight * 0.10
                : lingeringChart
                  ? viewportTop + viewportHeight * 0.48
                  : releaseLine;

            keepFrameWithDescendants(target, releaseAnchor, targetReleaseLine);
          }
        };

        const scheduleScrollUpdate = () => {
          if (scrollFrame) return;
          scrollFrame = window.requestAnimationFrame(updateScrollHighlights);
        };

        const startTracking = () => {
          updateScrollHighlights();

          document
            .querySelectorAll<HTMLElement>('.mobile-initial-highlight-group')
            .forEach((target) => target.classList.remove('mobile-initial-highlight-group'));

          window.addEventListener('scroll', scheduleScrollUpdate, { passive: true });
          window.addEventListener('resize', scheduleScrollUpdate, { passive: true });
          window.addEventListener('orientationchange', scheduleScrollUpdate, { passive: true });
          window.visualViewport?.addEventListener('resize', scheduleScrollUpdate, { passive: true });
          window.visualViewport?.addEventListener('scroll', scheduleScrollUpdate, { passive: true });

          if ('ResizeObserver' in window) {
            geometryObserver = new ResizeObserver(() => scheduleScrollUpdate());
            targets.forEach((target) => geometryObserver?.observe(target));
            const main = document.querySelector<HTMLElement>('main');
            if (main) geometryObserver.observe(main);
          }

          document.fonts?.ready
            .then(() => scheduleScrollUpdate())
            .catch(() => {});
          window.addEventListener('load', scheduleScrollUpdate, { once: true, passive: true });
          scheduleScrollUpdate();
        };

        startTracking();
      }

      if (finePointer && !reducedMotion) {
        const desktopFrames = Array.from(
          document.querySelectorAll<HTMLElement>(
            '.scroll-frame-major, .project-page .scroll-frame-focus, .project-page .metric-card',
          ),
        );
        desktopFrames.forEach((target) => target.classList.add('desktop-scroll-frame'));

        let desktopScrollFrame = 0;
        const clampDesktop = (value: number) => Math.min(1, Math.max(0, value));
        const smoothDesktop = (value: number) => {
          const t = clampDesktop(value);
          return t * t * (3 - 2 * t);
        };

        const setDesktopFrame = (
          target: HTMLElement,
          strength: number,
          phase: 'entry' | 'active' | 'exit',
        ) => {
          const progress = smoothDesktop(strength);
          let clipTop = 0;
          let clipBottom = 0;

          if (phase === 'entry') {
            clipBottom = (1 - progress) * 100;
          } else if (phase === 'exit') {
            clipTop = (1 - progress) * 100;
          }

          target.style.setProperty('--desktop-frame-strength', progress.toFixed(4));
          target.style.setProperty('--desktop-frame-clip-top', `${clipTop.toFixed(2)}%`);
          target.style.setProperty('--desktop-frame-clip-bottom', `${clipBottom.toFixed(2)}%`);
        };

        const updateDesktopFrames = () => {
          desktopScrollFrame = 0;
          const viewportHeight = window.innerHeight;
          const entryLine = viewportHeight * 0.86;
          const releaseLine = viewportHeight * 0.14;

          const frameRects = desktopFrames.map((target) => ({
            target,
            rect: target.getBoundingClientRect(),
          }));

          for (const { target, rect } of frameRects) {
            const drawDistance = Math.min(
              260,
              Math.max(
                150,
                viewportHeight * 0.11 + Math.min(rect.height, 520) * 0.16,
              ),
            );

            if (rect.top > entryLine) {
              setDesktopFrame(target, 0, 'entry');
              continue;
            }

            const entryEnd = entryLine - drawDistance;
            if (rect.top > entryEnd) {
              const progress = clampDesktop((entryLine - rect.top) / drawDistance);
              setDesktopFrame(target, progress, 'entry');
              continue;
            }

            if (rect.bottom > releaseLine) {
              setDesktopFrame(target, 1, 'active');
              continue;
            }

            const exitProgress = clampDesktop((releaseLine - rect.bottom) / drawDistance);
            setDesktopFrame(target, 1 - exitProgress, 'exit');
          }
        };

        const scheduleDesktopUpdate = () => {
          if (desktopScrollFrame) return;
          desktopScrollFrame = window.requestAnimationFrame(updateDesktopFrames);
        };

        window.addEventListener('scroll', scheduleDesktopUpdate, { passive: true });
        window.addEventListener('resize', scheduleDesktopUpdate, { passive: true });
        updateDesktopFrames();
      }
    </script>
  </body>
</html>