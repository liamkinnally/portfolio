---
import '../styles/global.css';
import '../styles/theme-overrides.css';
import Header from '../components/Header.astro';
import ParticleCanvas from '../components/ParticleCanvas.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Liam Kinnally — Software Engineering, QA & AI/ML',
  description = 'Portfolio of Liam Kinnally, an Information Technology student at UCF focused on software engineering, software QA, and AI/ML.',
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <script is:inline>
      (() => {
        let theme = 'dark';
        try {
          if (localStorage.getItem('theme') === 'light') theme = 'light';
        } catch {}
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#07090d" />
    <meta name="robots" content="index, follow" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Liam Kinnally" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        const meta = document.querySelector('meta[name="theme-color"]');
        if (meta && document.documentElement.dataset.theme === 'light') {
          meta.setAttribute('content', '#f7f9fd');
        }
      })();
    </script>
  </head>
  <body>
    <ParticleCanvas />
    <Header />
    <main class="relative z-10">
      <slot />
    </main>
  </body>
</html>
