---
import BaseLayout from '../layouts/BaseLayout.astro';
import MetricCard from '../components/MetricCard.astro';
---

<BaseLayout>
  <section class="container-shell flex min-h-[92vh] items-center pt-28 pb-20">
    <div class="max-w-4xl">
      <div class="eyebrow">UCF · Information Technology</div>
      <h1 class="gradient-text mt-7 max-w-4xl text-5xl font-[780] leading-[0.98] tracking-[-0.055em] sm:text-6xl md:text-7xl lg:text-[5.4rem]">
        I build software that turns messy data into useful systems.
      </h1>
      <p class="mt-7 max-w-2xl text-lg leading-8 text-slate-400 sm:text-xl">
        I’m Liam Kinnally, a senior Information Technology student at the University of Central Florida focused on software engineering, software QA, and AI/ML.
      </p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a href="#work" class="button-primary">View my work <span aria-hidden="true">↓</span></a>
        <a href="https://github.com/liamkinnally" target="_blank" rel="noreferrer" class="button-secondary">GitHub ↗</a>
      </div>

      <div class="mt-14 flex flex-wrap gap-x-7 gap-y-3 text-sm text-slate-500">
        <span>Python</span><span>Java</span><span>C</span><span>SQL</span><span>TypeScript</span><span>GitHub Actions</span>
      </div>
    </div>
  </section>

  <section id="work" class="container-shell scroll-mt-24 py-24">
    <div class="mb-10 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <div class="eyebrow">Featured work</div>
        <h2 class="mt-4 text-3xl font-bold tracking-[-0.035em] sm:text-4xl">NBA Player Stat Prediction</h2>
      </div>
      <a href="/projects/nba-scoring-model" class="text-sm font-semibold text-blue-200 transition hover:text-white">Read case study →</a>
    </div>

    <a href="/projects/nba-scoring-model" class="group block">
      <article class="glass-card overflow-hidden rounded-2xl transition duration-300 group-hover:-translate-y-1 group-hover:border-blue-200/20">
        <div class="grid lg:grid-cols-[1.12fr_0.88fr]">
          <div class="p-6 sm:p-8 lg:p-10">
            <div class="flex flex-wrap gap-2">
              <span class="kbd-tag">Python</span>
              <span class="kbd-tag">scikit-learn</span>
              <span class="kbd-tag">SQLAlchemy</span>
              <span class="kbd-tag">pytest</span>
              <span class="kbd-tag">GitHub Actions</span>
            </div>

            <h3 class="mt-7 max-w-xl text-2xl font-bold tracking-[-0.03em] sm:text-3xl">A reproducible ML pipeline for predicting NBA player performance.</h3>
            <p class="mt-4 max-w-2xl leading-7 text-slate-400">
              Built an end-to-end data pipeline, leakage-safe feature engineering, chronological model evaluation, serialized artifacts, and automated tests around real NBA player-game data.
            </p>

            <div class="mt-8 grid gap-3 sm:grid-cols-3">
              <MetricCard value="26,547" label="Player-games" />
              <MetricCard value="4.85" label="Points MAE" />
              <MetricCard value="23 / 28" label="Windows won" detail="vs. 10-game rolling baseline" />
            </div>
          </div>

          <div class="relative min-h-[360px] overflow-hidden border-t border-white/[0.07] bg-[#090d15] p-6 lg:border-t-0 lg:border-l lg:p-8">
            <div class="absolute inset-0 bg-[radial-gradient(circle_at_70%_20%,rgba(86,122,255,0.17),transparent_45%)]"></div>
            <div class="relative flex h-full flex-col justify-between rounded-xl border border-white/[0.08] bg-black/20 p-5">
              <div class="flex items-center justify-between text-xs text-slate-500">
                <span>evaluation / points</span>
                <span>chronological holdout</span>
              </div>
              <svg class="mt-10 w-full" viewBox="0 0 520 240" role="img" aria-label="Stylized model evaluation visualization">
                <defs>
                  <linearGradient id="modelLine" x1="0" x2="1">
                    <stop offset="0%" stop-color="#78a7ff" />
                    <stop offset="100%" stop-color="#aa8cff" />
                  </linearGradient>
                </defs>
                <g stroke="rgba(255,255,255,0.07)" stroke-width="1">
                  <line x1="0" y1="40" x2="520" y2="40"/><line x1="0" y1="100" x2="520" y2="100"/><line x1="0" y1="160" x2="520" y2="160"/><line x1="0" y1="220" x2="520" y2="220"/>
                </g>
                <path d="M0,159 C44,170 63,142 98,150 C135,158 156,122 194,129 C232,137 249,102 286,111 C326,120 347,87 386,98 C428,110 457,70 520,82" fill="none" stroke="rgba(148,163,184,0.45)" stroke-width="3" stroke-dasharray="7 8" />
                <path d="M0,142 C39,126 70,141 104,115 C137,91 169,112 204,90 C245,65 267,91 307,69 C344,49 372,72 414,50 C451,31 480,50 520,28" fill="none" stroke="url(#modelLine)" stroke-width="4" stroke-linecap="round" />
              </svg>
              <div class="mt-8 flex items-center justify-between text-xs">
                <span class="text-slate-500">Model</span>
                <span class="font-semibold text-blue-200">beats baseline in 23/28 windows</span>
              </div>
            </div>
          </div>
        </div>
      </article>
    </a>
  </section>

  <section class="container-shell py-10">
    <hr class="section-rule" />
  </section>

  <section id="about" class="container-shell scroll-mt-24 py-24">
    <div class="grid gap-10 lg:grid-cols-[0.75fr_1.25fr]">
      <div>
        <div class="eyebrow">About</div>
        <h2 class="mt-4 text-3xl font-bold tracking-[-0.035em]">Software first.<br />Curiosity everywhere.</h2>
      </div>
      <div class="max-w-2xl space-y-5 text-[1.05rem] leading-8 text-slate-400">
        <p>
          I like work where software has to be correct, measurable, and useful — whether that means building a data pipeline, testing a system, or turning an idea into a product someone can actually use.
        </p>
        <p>
          Outside of development, I’m usually following the NBA, playing competitive games, or doing something car-related. Those interests tend to become project ideas sooner or later.
        </p>
        <div class="pt-3">
          <a href="https://github.com/liamkinnally" target="_blank" rel="noreferrer" class="button-secondary">Explore my GitHub ↗</a>
        </div>
      </div>
    </div>
  </section>

  <footer class="container-shell py-10">
    <hr class="section-rule" />
    <div class="flex flex-col gap-3 py-8 text-sm text-slate-500 sm:flex-row sm:items-center sm:justify-between">
      <span>© 2026 Liam Kinnally</span>
      <span>Built with Astro + Tailwind CSS</span>
    </div>
  </footer>
</BaseLayout>
