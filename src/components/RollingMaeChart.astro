---
import { pointsRollingMae } from '../data/rollingMae';

interface Props {
  compact?: boolean;
  animateHeading?: boolean;
  interactivePill?: boolean;
}

const { compact = false, animateHeading = false, interactivePill = false } = Astro.props;
const data = pointsRollingMae;
const width = 760;
const height = 360;
const margin = { top: 28, right: 24, bottom: 48, left: 54 };
const plotWidth = width - margin.left - margin.right;
const plotHeight = height - margin.top - margin.bottom;
const yMin = 4.4;
const yMax = 5.5;
const yTicks = [4.5, 4.75, 5.0, 5.25, 5.5];
const xLabelIndexes = [0, 7, 14, 21, 27];
const wins = data.filter((point) => point.model < point.baseline).length;

const x = (index: number) => margin.left + (index / (data.length - 1)) * plotWidth;
const y = (value: number) => margin.top + ((yMax - value) / (yMax - yMin)) * plotHeight;
const linePath = (key: 'model' | 'baseline') =>
  data.map((point, index) => `${index === 0 ? 'M' : 'L'} ${x(index).toFixed(2)} ${y(point[key]).toFixed(2)}`).join(' ');
const modelPath = linePath('model');
const baselinePath = linePath('baseline');
const areaPath = `${modelPath} L ${x(data.length - 1).toFixed(2)} ${(margin.top + plotHeight).toFixed(2)} L ${x(0).toFixed(2)} ${(margin.top + plotHeight).toFixed(2)} Z`;
const formatDate = (date: string) => {
  const [, month, day] = date.split('-');
  return `${month === '03' ? 'Mar' : 'Apr'} ${Number(day)}`;
};
---

<div class:list={[
  'chart-shell',
  compact && 'chart-shell--compact',
  !compact && 'scroll-frame-focus',
  !compact && 'scroll-frame-quiet',
  !compact && 'scroll-frame-clipped',
]}>
  <div class="flex flex-col gap-4 px-5 pt-5 sm:flex-row sm:items-start sm:justify-between sm:px-6 sm:pt-6">
    <div>
      <div class="text-[0.7rem] font-bold uppercase tracking-[0.16em] text-slate-400">Chronological holdout · points</div>
      <h3
        class:list={['mt-2 text-base font-semibold tracking-[-0.015em] text-slate-100 sm:text-lg', animateHeading && 'scroll-heading-shine']}
        data-scroll-heading={animateHeading ? '' : undefined}
        data-shine-text={animateHeading ? 'Trailing 7-day MAE' : undefined}
      >Trailing 7-day MAE</h3>
    </div>
    <div class:list={['mae-wins-pill flex items-center gap-2 self-start rounded-full border border-blue-300/15 bg-blue-300/[0.06] px-3 py-1.5', (interactivePill || compact) && 'interactive-pill']}>
      <span class="text-sm font-bold text-blue-200">{wins}/28</span>
      <span class="text-[0.68rem] font-semibold uppercase tracking-[0.12em] text-slate-400">windows won</span>
    </div>
  </div>

  <div class="mt-2 flex flex-wrap gap-x-5 gap-y-2 px-5 text-xs text-slate-400 sm:px-6">
    <span class="inline-flex items-center gap-2"><span class="h-[2px] w-5 rounded-full bg-[#8eb7ff]"></span>Gradient boosting</span>
    <span class="inline-flex items-center gap-2"><span class="h-0 w-5 border-t border-dashed border-slate-500"></span>10-game baseline</span>
    <span class="hidden sm:inline">Lower is better</span>
  </div>

  <div class="relative mt-2 px-2 pb-2 sm:px-3 sm:pb-3">
    <svg class="block h-auto w-full" viewBox={`0 0 ${width} ${height}`} role="img" aria-labelledby="rolling-mae-title rolling-mae-desc">
      <title id="rolling-mae-title">Rolling mean absolute error for the points model versus baseline</title>
      <desc id="rolling-mae-desc">Across 28 complete trailing seven-day windows, the gradient boosting model has lower error than the ten-game rolling-average baseline in 23 windows.</desc>
      <defs>
        <linearGradient id="mae-model-line" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0%" stop-color="#78a7ff" />
          <stop offset="55%" stop-color="#96b9ff" />
          <stop offset="100%" stop-color="#b09aff" />
        </linearGradient>
        <linearGradient id="mae-area" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#78a7ff" stop-opacity="0.18" />
          <stop offset="100%" stop-color="#78a7ff" stop-opacity="0" />
        </linearGradient>
        <filter id="mae-glow" x="-20%" y="-20%" width="140%" height="140%">
          <feGaussianBlur stdDeviation="5" result="blur" />
          <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
        </filter>
        <filter id="mae-result-glow" x="-80%" y="-300%" width="260%" height="700%">
          <feGaussianBlur stdDeviation="2.25" result="resultBlur" />
          <feMerge><feMergeNode in="resultBlur"/><feMergeNode in="SourceGraphic"/></feMerge>
        </filter>
        <filter id="mae-tooltip-shadow" x="-30%" y="-30%" width="160%" height="180%">
          <feDropShadow dx="0" dy="4" stdDeviation="5" flood-color="#020617" flood-opacity="0.5" />
        </filter>
      </defs>

      <rect x={margin.left} y={margin.top} width={plotWidth} height={plotHeight} rx="14" fill="var(--chart-plot-bg)" />

      {yTicks.map((tick) => (
        <g>
          <line x1={margin.left} x2={margin.left + plotWidth} y1={y(tick)} y2={y(tick)} stroke="var(--chart-grid)" stroke-width="1" />
          <text x={margin.left - 12} y={y(tick) + 4} text-anchor="end" fill="var(--chart-label)" font-size="11" font-weight="600">{tick.toFixed(2)}</text>
        </g>
      ))}

      {xLabelIndexes.map((index) => (
        <text x={x(index)} y={margin.top + plotHeight + 28} text-anchor={index === 0 ? 'start' : index === data.length - 1 ? 'end' : 'middle'} fill="var(--chart-label)" font-size="11" font-weight="600">{formatDate(data[index].date)}</text>
      ))}

      <path d={areaPath} fill="url(#mae-area)" />
      <path class="chart-line chart-baseline" pathLength="1" d={baselinePath} fill="none" stroke="var(--chart-baseline)" stroke-width="2.2" stroke-dasharray="7 7" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke" />
      <path class="chart-line chart-model" pathLength="1" d={modelPath} fill="none" stroke="url(#mae-model-line)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke" filter="url(#mae-glow)" />

      {data.map((point, index) => (
        <circle cx={x(index)} cy={y(point.model)} r={point.model < point.baseline ? 2.6 : 2.1} fill={point.model < point.baseline ? '#7fa9f7' : 'var(--chart-point-muted)'} opacity={point.model < point.baseline ? 0.78 : 0.52} />
      ))}

      {!compact && data.map((point, index) => {
        const bandLeft = index === 0 ? margin.left : (x(index - 1) + x(index)) / 2;
        const bandRight = index === data.length - 1 ? margin.left + plotWidth : (x(index) + x(index + 1)) / 2;
        const tooltipWidth = 144;
        const tooltipHeight = 76;
        const tooltipGap = 12;
        const tooltipX = index < data.length / 2
          ? Math.min(x(index) + tooltipGap, margin.left + plotWidth - tooltipWidth - 8)
          : Math.max(x(index) - tooltipWidth - tooltipGap, margin.left + 8);
        const tooltipY = margin.top + 10;
        const delta = point.model - point.baseline;
        const isWin = delta < 0;
        const resultLabel = `${isWin ? 'Win' : 'Loss'} · ${Math.abs(delta).toFixed(2)} ${isWin ? 'lower' : 'higher'}`;

        return (
          <g class="date-hover-group">
            <rect class="date-hover-hit" x={bandLeft} y={margin.top} width={bandRight - bandLeft} height={plotHeight} fill="transparent" />
            <line class="date-hover-guide" x1={x(index)} x2={x(index)} y1={margin.top} y2={margin.top + plotHeight} />
            <circle class="date-hover-point date-hover-point--model" cx={x(index)} cy={y(point.model)} r="4.5" />
            <circle class="date-hover-point date-hover-point--baseline" cx={x(index)} cy={y(point.baseline)} r="4" />
            <g class="date-hover-tooltip" transform={`translate(${tooltipX}, ${tooltipY})`}>
              <rect class="date-hover-tooltip-box" width={tooltipWidth} height={tooltipHeight} rx="9" filter="url(#mae-tooltip-shadow)" />
              <text class="date-hover-tooltip-date" x="10" y="17">{formatDate(point.date)}</text>
              <text class="date-hover-tooltip-label" x="10" y="36">Model</text>
              <text class="date-hover-tooltip-value date-hover-tooltip-value--model" x={tooltipWidth - 10} y="36" text-anchor="end">{point.model.toFixed(2)}</text>
              <text class="date-hover-tooltip-label" x="10" y="52">Baseline</text>
              <text class="date-hover-tooltip-value" x={tooltipWidth - 10} y="52" text-anchor="end">{point.baseline.toFixed(2)}</text>
              <text class:list={['date-hover-tooltip-result', isWin ? 'date-hover-tooltip-result--win' : 'date-hover-tooltip-result--loss']} x="10" y="68">{resultLabel}</text>
            </g>
          </g>
        );
      })}

      <g transform={`translate(${margin.left}, ${margin.top + plotHeight + 42})`}>
        {data.map((point, index) => {
          const resultX = (index / data.length) * plotWidth + 1;
          const resultWidth = Math.max(2, plotWidth / data.length - 3);
          const isWin = point.model < point.baseline;

          return (
            <g class:list={['window-result', isWin ? 'window-result--win' : 'window-result--loss']}>
              <rect class="window-result-hit" x={resultX} y="-5" width={resultWidth} height="13" rx="3" fill="transparent" />
              <rect class="window-result-bar" x={resultX} y="0" width={resultWidth} height="3" rx="1.5" fill={isWin ? '#6f9cf2' : 'var(--chart-result-muted)'} opacity={isWin ? 0.76 : 0.48} />
            </g>
          );
        })}
      </g>
    </svg>
  </div>

  {!compact && (
    <div class="mx-5 mb-5 flex flex-col gap-2 border-t border-white/[0.07] pt-4 text-sm leading-6 text-slate-400 sm:mx-6 sm:mb-6 sm:flex-row sm:items-center sm:justify-between">
      <span>Each point evaluates the same chronological holdout rows for the model and baseline.</span>
      <span class="shrink-0 font-semibold text-blue-200">23 wins · 5 losses</span>
    </div>
  )}
</div>

<style>
  .chart-shell {
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 1rem;
    background: var(--chart-shell-bg);
    box-shadow: var(--chart-shadow);
  }

  .chart-shell--compact {
    width: 100%;
  }

  .chart-model {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: chart-draw 900ms 180ms cubic-bezier(.2,.7,.2,1) forwards;
  }

  .chart-baseline {
    stroke-dasharray: .018 .018;
    stroke-dashoffset: 1;
    animation: chart-draw 760ms 80ms cubic-bezier(.2,.7,.2,1) forwards;
  }

  .date-hover-guide,
  .date-hover-point,
  .date-hover-tooltip {
    opacity: 0;
    pointer-events: none;
  }

  .date-hover-guide {
    stroke: var(--chart-label);
    stroke-width: 1;
    stroke-dasharray: 3 5;
    vector-effect: non-scaling-stroke;
  }

  .date-hover-point {
    transform-box: fill-box;
    transform-origin: center;
    transform: scale(0.72);
    vector-effect: non-scaling-stroke;
  }

  .date-hover-point--model {
    fill: #8eb7ff;
    stroke: #d9e7ff;
    stroke-width: 1.2;
  }

  .date-hover-point--baseline {
    fill: var(--chart-plot-bg);
    stroke: var(--chart-baseline);
    stroke-width: 2;
  }

  .date-hover-tooltip-box {
    fill: #0b1324;
    fill-opacity: 0.96;
    stroke: rgba(148, 163, 184, 0.24);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .date-hover-tooltip-date {
    fill: #e2e8f0;
    font-size: 11px;
    font-weight: 700;
  }

  .date-hover-tooltip-label {
    fill: #94a3b8;
    font-size: 10px;
    font-weight: 600;
  }

  .date-hover-tooltip-value {
    fill: #cbd5e1;
    font-size: 10px;
    font-weight: 700;
  }

  .date-hover-tooltip-value--model {
    fill: #9fc0ff;
  }

  .date-hover-tooltip-result {
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .date-hover-tooltip-result--win {
    fill: #93b7ff;
  }

  .date-hover-tooltip-result--loss {
    fill: #94a3b8;
  }

  .window-result-bar {
    transform-box: fill-box;
    transform-origin: center;
  }

  @media (hover: hover) and (pointer: fine) {
    .date-hover-guide {
      transition: opacity 140ms ease;
    }

    .date-hover-point {
      transition: opacity 140ms ease, transform 160ms ease;
    }

    .date-hover-tooltip {
      transition: opacity 130ms ease;
    }

    .date-hover-group:hover .date-hover-guide {
      opacity: 0.36;
    }

    .date-hover-group:hover .date-hover-point,
    .date-hover-group:hover .date-hover-tooltip {
      opacity: 1;
    }

    .date-hover-group:hover .date-hover-point {
      transform: scale(1);
    }

    .window-result-bar {
      transition: opacity 160ms ease, filter 180ms ease, transform 180ms ease;
    }

    .window-result--win:hover .window-result-bar {
      opacity: 1;
      filter: url(#mae-result-glow);
      transform: scaleY(1.35);
    }

    .window-result--loss:hover .window-result-bar {
      opacity: 0.68;
      transform: scaleY(1.15);
    }
  }

  @keyframes chart-draw {
    to { stroke-dashoffset: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .chart-model,
    .chart-baseline {
      animation: none;
      stroke-dashoffset: 0;
    }

    .date-hover-guide,
    .date-hover-point,
    .date-hover-tooltip,
    .window-result-bar {
      transition: none;
    }

    .date-hover-point,
    .window-result--win:hover .window-result-bar,
    .window-result--loss:hover .window-result-bar {
      transform: none;
    }
  }
</style>
