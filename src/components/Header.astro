---
import PresenceIndicator from './PresenceIndicator.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="site-header fixed inset-x-0 top-0 z-50 border-b backdrop-blur-xl">
  <div class="container-shell flex h-16 items-center justify-between gap-3">
    <div class="flex items-center gap-5">
      <a href="/" class="group" aria-label="Home">
        <span class="text-sm font-semibold tracking-[-0.015em] text-slate-100 transition group-hover:text-white">Home</span>
      </a>
      <PresenceIndicator />
    </div>

    <div class="flex items-center gap-1.5 sm:gap-2">
      <nav class="flex items-center gap-0.5 text-[0.78rem] text-slate-300 sm:gap-1 sm:text-sm" aria-label="Primary navigation">
        <a href="/#work" class="nav-link">Projects</a>
        <a href="/#skills" class="nav-link">Skills</a>
        <a href="/#about" class="nav-link">About</a>
        <a
          href="https://github.com/liamkinnally"
          target="_blank"
          rel="noreferrer"
          class="social-link hidden sm:inline-flex"
          aria-label="GitHub profile"
          title="GitHub"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path fill="currentColor" d="M12 .7a11.5 11.5 0 0 0-3.64 22.41c.58.11.79-.25.79-.56v-2.24c-3.23.7-3.91-1.37-3.91-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.71.08-.71 1.17.08 1.78 1.2 1.78 1.2 1.04 1.78 2.72 1.27 3.39.97.1-.75.4-1.27.74-1.56-2.58-.29-5.29-1.29-5.29-5.75 0-1.27.45-2.31 1.2-3.13-.12-.3-.52-1.48.11-3.08 0 0 .98-.31 3.16 1.2a10.96 10.96 0 0 1 5.75 0c2.19-1.51 3.17-1.2 3.17-1.2.63 1.6.23 2.78.11 3.08.75.82 1.2 1.86 1.2 3.13 0 4.47-2.72 5.45-5.31 5.74.42.36.79 1.07.79 2.16v3.2c0 .31.21.68.8.56A11.5 11.5 0 0 0 12 .7Z" />
          </svg>
        </a>
        <a
          href="https://www.linkedin.com/in/liamkinnally"
          target="_blank"
          rel="noreferrer"
          class="social-link hidden sm:inline-flex"
          aria-label="LinkedIn profile"
          title="LinkedIn"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path fill="currentColor" d="M5.37 3.53a2.14 2.14 0 1 1 0 4.28 2.14 2.14 0 0 1 0-4.28ZM3.52 9.3h3.7V21h-3.7V9.3Zm5.92 0h3.55v1.6h.05c.49-.94 1.7-1.94 3.5-1.94 3.74 0 4.43 2.46 4.43 5.66V21h-3.7v-5.65c0-1.35-.03-3.08-1.88-3.08-1.88 0-2.17 1.47-2.17 2.98V21h-3.7V9.3Z" />
          </svg>
        </a>
      </nav>
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .social-link {
    width: 2.25rem;
    height: 2.25rem;
    align-items: center;
    justify-content: center;
    border-radius: 0.55rem;
    color: inherit;
    transition: color 160ms ease, background 160ms ease, transform 160ms ease;
  }

  .social-link:hover {
    color: var(--text);
    background: var(--nav-hover);
    transform: translateY(-1px);
  }

  .social-link svg {
    width: 1.05rem;
    height: 1.05rem;
    display: block;
  }
</style>
