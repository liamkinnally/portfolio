---
import { pointsPermutationImportance as data } from '../data/permutationImportance';

const width = 760;
const height = 390;
const margin = { top: 22, right: 78, bottom: 52, left: 190 };
const plotWidth = width - margin.left - margin.right;
const plotHeight = height - margin.top - margin.bottom;
const maxValue = 1.9;
const xTicks = [0, 0.5, 1.0, 1.5];
const rowHeight = plotHeight / data.length;
const x = (value: number) => margin.left + (value / maxValue) * plotWidth;
const formatValue = (value: number) => value >= 0.1 ? value.toFixed(2) : value.toFixed(3);
---

<div class="chart-shell scroll-frame-focus scroll-frame-quiet scroll-frame-clipped">
  <div class="flex flex-col gap-4 px-5 pt-5 sm:flex-row sm:items-start sm:justify-between sm:px-6 sm:pt-6">
    <div>
      <div class="text-[0.7rem] font-bold uppercase tracking-[0.16em] text-slate-400">Model interpretability · points</div>
      <h3
        class="scroll-heading-shine mt-2 text-base font-semibold tracking-[-0.015em] text-slate-100 sm:text-lg"
        data-scroll-heading
        data-shine-text="Permutation importance"
      >Permutation importance</h3>
    </div>
    <div class="interactive-pill self-start rounded-full border border-blue-300/15 bg-blue-300/[0.06] px-3 py-1.5 text-xs font-semibold text-blue-200">
      MAE increase when shuffled
    </div>
  </div>

  <div class="mt-2 px-2 pb-2 sm:px-3 sm:pb-3">
    <svg class="block h-auto w-full" viewBox={`0 0 ${width} ${height}`} role="img" aria-labelledby="importance-title importance-desc" data-importance-chart>
      <title id="importance-title">Permutation importance for the points model</title>
      <desc id="importance-desc">The ten-game points average is the dominant feature. Recent minutes are the strongest secondary feature, followed by activity, shorter-term scoring form, rest, opponent history, and recent rebounds.</desc>

      <defs>
        <linearGradient id="importance-bar" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0%" stop-color="#6895ef" />
          <stop offset="100%" stop-color="#987be6" />
        </linearGradient>
        <linearGradient id="importance-flow" x1="-0.7" y1="0" x2="1.3" y2="0">
          <stop offset="0%" stop-color="#6895ef" stop-opacity="0" />
          <stop offset="24%" stop-color="#6895ef" stop-opacity="0.10" />
          <stop offset="40%" stop-color="#987be6" stop-opacity="0.58" />
          <stop offset="54%" stop-color="#6895ef" stop-opacity="0.22" />
          <stop offset="69%" stop-color="#987be6" stop-opacity="0.48" />
          <stop offset="100%" stop-color="#987be6" stop-opacity="0" />
          <animateTransform
            attributeName="gradientTransform"
            type="translate"
            values="-0.42 0;0.34 0;-0.12 0;-0.42 0"
            keyTimes="0;0.46;0.78;1"
            dur="6.8s"
            repeatCount="indefinite"
          />
        </linearGradient>
        <filter id="importance-glow" x="-20%" y="-40%" width="140%" height="180%">
          <feGaussianBlur stdDeviation="4" result="blur" />
          <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
        </filter>
      </defs>

      {xTicks.map((tick) => (
        <g>
          <line x1={x(tick)} x2={x(tick)} y1={margin.top} y2={margin.top + plotHeight} stroke="var(--chart-grid)" stroke-width="1" />
          <text x={x(tick)} y={margin.top + plotHeight + 28} text-anchor="middle" fill="var(--chart-label)" font-size="11" font-weight="600">{tick.toFixed(1)}</text>
        </g>
      ))}

      {data.map((point, index) => {
        const centerY = margin.top + rowHeight * index + rowHeight / 2;
        const barHeight = Math.min(24, rowHeight * 0.52);
        const barWidth = Math.max(1.5, x(point.mean) - margin.left);
        const errorLeft = x(Math.max(0, point.mean - point.std));
        const errorRight = x(Math.min(maxValue, point.mean + point.std));
        const barOpacity = index === 0 ? 0.95 : Math.max(0.48, 0.82 - index * 0.055);
        const flowOpacity = Math.min(0.44, 0.24 + barOpacity * 0.16);

        return (
          <g>
            <text x={margin.left - 14} y={centerY + 4} text-anchor="end" fill="var(--chart-label-strong)" font-size="11.5" font-weight={index === 0 ? '700' : '600'}>{point.label}</text>
            <rect x={margin.left} y={centerY - barHeight / 2} width={plotWidth} height={barHeight} rx={barHeight / 2} fill="var(--chart-track)" />
            <rect class="importance-bar" x={margin.left} y={centerY - barHeight / 2} width={barWidth} height={barHeight} rx={barHeight / 2} fill="url(#importance-bar)" opacity={barOpacity} filter={index === 0 ? 'url(#importance-glow)' : undefined} />
            <rect
              class="importance-flow"
              x={margin.left}
              y={centerY - barHeight / 2}
              width={barWidth}
              height={barHeight}
              rx={barHeight / 2}
              fill="url(#importance-flow)"
              style={`--importance-flow-opacity: ${flowOpacity.toFixed(3)}; animation-delay: ${(-index * 0.62).toFixed(2)}s;`}
            />
            <line x1={errorLeft} x2={errorRight} y1={centerY} y2={centerY} stroke="var(--chart-error)" stroke-width="1.2" opacity="0.72" />
            <line x1={errorLeft} x2={errorLeft} y1={centerY - 4} y2={centerY + 4} stroke="var(--chart-error)" stroke-width="1.2" opacity="0.72" />
            <line x1={errorRight} x2={errorRight} y1={centerY - 4} y2={centerY + 4} stroke="var(--chart-error)" stroke-width="1.2" opacity="0.72" />
            <text x={Math.min(width - 8, x(point.mean) + 10)} y={centerY + 4} fill={index === 0 ? 'var(--chart-value-strong)' : 'var(--chart-value)'} font-size="11" font-weight="700">+{formatValue(point.mean)}</text>
          </g>
        );
      })}

      <text x={margin.left + plotWidth / 2} y={height - 7} text-anchor="middle" fill="var(--chart-axis)" font-size="10.5" font-weight="600">Increase in holdout MAE after feature shuffling</text>
    </svg>
  </div>

  <div class="mx-5 mb-5 border-t border-white/[0.07] pt-4 text-sm leading-6 text-slate-400 sm:mx-6 sm:mb-6">
    Shuffling the 10-game scoring average increases error by about 1.80 points, far more than any other feature. Error bars show the standard deviation across permutation repeats.
  </div>
</div>

<script>
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<SVGSVGElement>('[data-importance-chart]').forEach((chart) => chart.pauseAnimations());
  }
</script>

<style>
  .chart-shell {
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 1rem;
    background: var(--chart-shell-bg);
    box-shadow: var(--chart-shadow);
  }

  .importance-bar,
  .importance-flow {
    transform-box: fill-box;
    transform-origin: left center;
  }

  .importance-bar {
    animation: importance-grow 650ms cubic-bezier(.2,.7,.2,1) both;
  }

  .importance-flow {
    pointer-events: none;
    opacity: var(--importance-flow-opacity);
    animation: importance-flow-breathe 5.2s ease-in-out infinite;
  }

  @keyframes importance-grow {
    from { transform: scaleX(0); opacity: 0; }
  }

  @keyframes importance-flow-breathe {
    0%, 100% { opacity: calc(var(--importance-flow-opacity) * 0.52); }
    44% { opacity: var(--importance-flow-opacity); }
    68% { opacity: calc(var(--importance-flow-opacity) * 0.72); }
  }

  @media (prefers-reduced-motion: reduce) {
    .importance-bar,
    .importance-flow {
      animation: none;
    }
  }
</style>
