<button
  id="theme-toggle"
  class="theme-toggle"
  type="button"
  aria-label="Switch to light mode"
  title="Switch to light mode"
>
  <svg class="theme-icon theme-icon--sun" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="3.5" />
    <path d="M12 2.5v2M12 19.5v2M4.5 12h-2M21.5 12h-2M5.3 5.3 6.7 6.7M17.3 17.3l1.4 1.4M18.7 5.3l-1.4 1.4M6.7 17.3l-1.4 1.4" />
  </svg>
  <svg class="theme-icon theme-icon--moon" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M20.2 15.3A8.5 8.5 0 0 1 8.7 3.8 8.5 8.5 0 1 0 20.2 15.3Z" />
  </svg>
</button>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('#theme-toggle');

  const syncToggle = () => {
    if (!toggle) return;
    const isLight = document.documentElement.dataset.theme === 'light';
    const nextTheme = isLight ? 'dark' : 'light';
    toggle.setAttribute('aria-label', `Switch to ${nextTheme} mode`);
    toggle.setAttribute('title', `Switch to ${nextTheme} mode`);
  };

  toggle?.addEventListener('click', () => {
    const nextTheme = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
    document.documentElement.dataset.theme = nextTheme;

    try {
      localStorage.setItem('theme', nextTheme);
    } catch {}

    const themeColor = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
    themeColor?.setAttribute('content', nextTheme === 'light' ? '#f7f9fd' : '#07090d');
    window.dispatchEvent(new CustomEvent('themechange', { detail: { theme: nextTheme } }));
    syncToggle();
  });

  syncToggle();
</script>

<style>
  .theme-toggle {
    display: grid;
    width: 2.25rem;
    height: 2.25rem;
    place-items: center;
    flex: 0 0 auto;
    border: 1px solid var(--border);
    border-radius: 0.7rem;
    background: var(--control-bg);
    color: var(--muted);
    cursor: pointer;
    transition: color 160ms ease, border-color 160ms ease, background 160ms ease, transform 160ms ease;
  }

  .theme-toggle:hover {
    color: var(--text);
    border-color: var(--border-strong);
    background: var(--control-bg-hover);
    transform: translateY(-1px);
  }

  .theme-toggle:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .theme-icon {
    grid-area: 1 / 1;
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: opacity 160ms ease, transform 200ms ease;
  }

  .theme-icon--sun {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  .theme-icon--moon {
    opacity: 0;
    transform: rotate(-18deg) scale(0.72);
  }

  :global(html[data-theme='light']) .theme-icon--sun {
    opacity: 0;
    transform: rotate(18deg) scale(0.72);
  }

  :global(html[data-theme='light']) .theme-icon--moon {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }
</style>
