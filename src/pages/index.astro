---
import BaseLayout from '../layouts/BaseLayout.astro';
import MetricCard from '../components/MetricCard.astro';
import RollingMaeChart from '../components/RollingMaeChart.astro';
---

<BaseLayout>
  <section class="container-shell flex min-h-[92vh] items-center pt-28 pb-20">
    <div class="fade-up max-w-4xl">
      <div class="eyebrow">UCF · B.S. in Information Technology · CECS</div>
      <h1
        class="scroll-heading-shine gradient-text mt-7 text-6xl font-[790] leading-[0.94] tracking-[-0.06em] sm:text-7xl md:text-8xl lg:text-[6.4rem]"
        data-scroll-heading
        data-shine-text="Liam Kinnally"
      >
        Liam Kinnally
      </h1>
      <p class="mt-6 text-lg font-semibold tracking-[-0.015em] text-blue-200 sm:text-xl">
        Software Engineering · Software Testing · AI / ML
      </p>
      <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-300 sm:text-xl">
        I build software and data-driven systems that are meant to be tested, measured, and improved.
      </p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a href="#work" class="button-primary">View projects <span aria-hidden="true">↓</span></a>
        <a href="#" class="button-primary" data-email-link aria-label="Email Liam Kinnally">Email ↗</a>
        <span class="relative inline-flex">
          <button
            type="button"
            class="button-secondary !w-[2.8rem] !px-0"
            data-copy-email
            aria-label="Copy Liam Kinnally email address"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
              <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
            </svg>
          </button>
          <span
            class="pointer-events-none absolute left-1/2 top-[-2.15rem] -translate-x-1/2 rounded-md border px-2 py-1 text-[0.7rem] font-semibold opacity-0 transition-opacity"
            style="border-color: var(--border); background: var(--surface-strong); color: var(--text);"
            data-copy-feedback
            aria-hidden="true"
          >Copied</span>
        </span>
        <a href="https://www.linkedin.com/in/liamkinnally" target="_blank" rel="noreferrer" class="button-secondary">LinkedIn ↗</a>
        <a href="https://github.com/liamkinnally" target="_blank" rel="noreferrer" class="button-secondary">GitHub ↗</a>
      </div>
      <div class="mt-8 flex flex-wrap items-center gap-2.5">
        <span class="availability-pill interactive-pill">Open to Spring 2027 & Summer 2027 internships</span>
        <span
          class="inline-flex items-center gap-1.5 rounded-full border px-[0.72rem] py-[0.48rem] text-[0.78rem] font-[580]"
          style="border-color: var(--border); background: var(--tag-bg); color: var(--muted);"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="13"
            height="13"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
          Orlando, FL
        </span>
      </div>
    </div>
  </section>

  <section id="work" class="container-shell scroll-mt-24 py-24">
    <div class="mb-10 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <div class="eyebrow">Featured project</div>
        <h2
          class="scroll-heading-shine mt-4 text-3xl font-bold tracking-[-0.035em] sm:text-4xl"
          data-scroll-heading
          data-shine-text="NBA Player Stat Prediction"
        >NBA Player Stat Prediction</h2>
      </div>
      <div class="flex gap-5 text-sm font-semibold">
        <a href="/projects/nba-scoring-model" class="featured-project-nav-link text-blue-200 transition hover:text-white">Explore project →</a>
        <a href="https://github.com/liamkinnally/nba-scoring-model" target="_blank" rel="noreferrer" class="featured-project-nav-link text-slate-300 transition hover:text-white">Source ↗</a>
      </div>
    </div>

    <article class="scroll-frame-focus scroll-frame-major scroll-frame-clipped glass-card overflow-hidden rounded-2xl">
      <div class="grid lg:grid-cols-[1.05fr_0.95fr]">
        <div class="p-6 sm:p-8 lg:p-10">
          <div class="flex flex-wrap gap-2">
            <span class="kbd-tag">Python</span>
            <span class="kbd-tag">scikit-learn</span>
            <span class="kbd-tag">SQLAlchemy</span>
            <span class="kbd-tag">pytest</span>
            <span class="kbd-tag">GitHub Actions</span>
          </div>
          <h3 class="mt-6 text-2xl font-bold tracking-[-0.03em]">A reproducible ML pipeline for predicting NBA player performance.</h3>
          <p class="mt-5 leading-7 text-slate-300">
            Built an end-to-end Python data pipeline to ingest, validate, store, model, and evaluate NBA player-game data. The project uses leakage-safe rolling features, expanding-window cross-validation, serialized model artifacts, and automated tests in CI.
          </p>
          <div class="mt-7 grid gap-3 sm:grid-cols-3">
            <MetricCard value="26,547" label="Player-games" />
            <MetricCard value="4.85" label="Points MAE" />
            <MetricCard value="23 / 28" label="Windows won" detail="vs. baseline" />
          </div>
          <div class="mt-8 flex flex-wrap gap-5 text-sm font-semibold">
            <a href="/projects/nba-scoring-model" class="text-blue-200 transition hover:text-white">Explore project →</a>
            <a href="https://github.com/liamkinnally/nba-scoring-model" target="_blank" rel="noreferrer" class="text-slate-300 transition hover:text-white">Source ↗</a>
          </div>
        </div>
        <div class="border-t border-white/10 p-6 sm:p-8 lg:flex lg:items-center lg:border-t-0 lg:border-l lg:p-10">
          <RollingMaeChart compact interactivePill />
        </div>
      </div>
    </article>
  </section>

  <section id="skills" class="container-shell scroll-mt-24 py-24">
    <div class="grid gap-12 lg:grid-cols-[0.75fr_1.25fr]">
      <div>
        <div class="eyebrow">Skills</div>
        <h2
          class="scroll-heading-shine mt-4 text-3xl font-bold tracking-[-0.035em] sm:text-4xl"
          data-scroll-heading
          data-shine-text="What I work with."
        >What I work with.</h2>
        <p class="mt-5 max-w-xl leading-7 text-slate-300">
          My strongest work is in Python and software/data tooling, with growing frontend experience through this portfolio and other projects.
        </p>
      </div>
      <div class="grid gap-5 sm:grid-cols-2">
        <div class="scroll-frame-focus scroll-frame-quiet glass-card rounded-2xl p-6">
          <h3 class="font-semibold">Languages</h3>
          <div class="mt-4 flex flex-wrap gap-2">
            <span class="kbd-tag">Python</span><span class="kbd-tag">C</span><span class="kbd-tag">Java</span><span class="kbd-tag">SQL</span><span class="kbd-tag">TypeScript</span>
          </div>
        </div>
        <div class="scroll-frame-focus scroll-frame-quiet glass-card rounded-2xl p-6">
          <h3 class="font-semibold">Testing & development</h3>
          <div class="mt-4 flex flex-wrap gap-2">
            <span class="kbd-tag">pytest</span><span class="kbd-tag">GitHub Actions</span><span class="kbd-tag">Git</span><span class="kbd-tag">CI/CD</span><span class="kbd-tag">Bash</span><span class="kbd-tag">VS Code</span>
          </div>
        </div>
        <div class="scroll-frame-focus scroll-frame-quiet glass-card rounded-2xl p-6">
          <h3 class="font-semibold">Data science & databases</h3>
          <div class="mt-4 flex flex-wrap gap-2">
            <span class="kbd-tag">pandas</span><span class="kbd-tag">NumPy</span><span class="kbd-tag">scikit-learn</span><span class="kbd-tag">SQLAlchemy</span><span class="kbd-tag">SQLite</span><span class="kbd-tag">MySQL</span><span class="kbd-tag">Matplotlib</span>
          </div>
        </div>
        <div class="scroll-frame-focus scroll-frame-quiet glass-card rounded-2xl p-6">
          <h3 class="font-semibold">Web & deployment</h3>
          <div class="mt-4 flex flex-wrap gap-2">
            <span class="kbd-tag">Astro</span><span class="kbd-tag">Tailwind CSS</span><span class="kbd-tag">HTML/CSS</span><span class="kbd-tag">Vercel</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="education" class="container-shell scroll-mt-24 py-24">
    <div class="scroll-frame-focus scroll-frame-major glass-card rounded-2xl p-7 sm:p-9">
      <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr]">
        <div>
          <div class="eyebrow">Education</div>
          <h2
            class="scroll-heading-shine mt-4 text-3xl font-bold tracking-[-0.035em]"
            data-scroll-heading
            data-shine-text="University of Central Florida"
          >University of Central Florida</h2>
          <p class="mt-3 text-lg font-semibold text-slate-200">B.S. in Information Technology</p>
          <p class="mt-1 text-slate-400">College of Engineering and Computer Science · Expected August 2027</p>
          <p class="mt-5 text-sm font-semibold text-blue-200">Dean’s List (Fall 2025) · President’s Honor Roll (Spring 2026)</p>
        </div>
        <div>
          <h3 class="font-semibold">Relevant coursework</h3>
          <div class="mt-4 flex flex-wrap gap-2">
            <span class="kbd-tag">Data Structures & Algorithms</span>
            <span class="kbd-tag">Discrete Mathematics</span>
            <span class="kbd-tag">Object-Oriented Programming (Java)</span>
            <span class="kbd-tag">Computer Architecture Concepts (Digital Logic & Assembly)</span>
            <span class="kbd-tag">Database Concepts (SQL & Database Connectivity)</span>
            <span class="kbd-tag">Secure Software Development</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="about" class="container-shell scroll-mt-24 py-24">
    <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr]">
      <h2
        class="scroll-heading-shine text-3xl font-bold tracking-[-0.035em] sm:text-4xl"
        data-scroll-heading
        data-shine-text="I like software that can prove it works."
      >I like software that can prove it works.</h2>
      <div class="space-y-5 text-lg leading-8 text-slate-300">
        <p>
          I’m the kind of person who likes understanding why something works, not just whether it works. That usually means digging into the details, testing assumptions, and finding ways to make things more reliable or useful. Software gives me a place to do that consistently, whether I’m building an application, working with data, or experimenting with a machine learning model.
        </p>
        <p>
          Outside of software, I’m usually following basketball, enjoying competitive strategy games, or fixating on the newest engineering developments in performance cars. I’m especially drawn to projects that connect software with the areas I’m most passionate about.
        </p>
      </div>
    </div>
  </section>

  <section class="container-shell py-24">
    <div class="scroll-frame-focus scroll-frame-major glass-card rounded-2xl p-8 sm:p-10">
      <div class="eyebrow">Get in touch</div>
      <h2
        class="scroll-heading-shine mt-4 text-3xl font-bold tracking-[-0.035em] sm:text-4xl"
        data-scroll-heading
        data-shine-text="Let’s build something."
      >Let’s build something.</h2>
      <p class="mt-4 max-w-2xl leading-7 text-slate-300">
        I’m currently pursuing software engineering, software testing/QA, and AI/ML-related internship opportunities. Based in Orlando, Florida — open to relocation.
      </p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a href="#" class="button-primary" data-email-link aria-label="Email Liam Kinnally">Email ↗</a>
        <!-- Resume button goes here later -->
        <span class="relative inline-flex">
          <button
            type="button"
            class="button-secondary !w-[2.8rem] !px-0"
            data-copy-email
            aria-label="Copy Liam Kinnally email address"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
              <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
            </svg>
          </button>
          <span
            class="pointer-events-none absolute left-1/2 top-[-2.15rem] -translate-x-1/2 rounded-md border px-2 py-1 text-[0.7rem] font-semibold opacity-0 transition-opacity"
            style="border-color: var(--border); background: var(--surface-strong); color: var(--text);"
            data-copy-feedback
            aria-hidden="true"
          >Copied</span>
        </span>
        <a href="https://www.linkedin.com/in/liamkinnally" target="_blank" rel="noreferrer" class="button-secondary">LinkedIn ↗</a>
        <a href="https://github.com/liamkinnally" target="_blank" rel="noreferrer" class="button-secondary">GitHub ↗</a>
      </div>
    </div>
  </section>

  <footer class="container-shell pb-10 pt-4 text-sm text-slate-500">
    <div class="flex flex-col gap-2 border-t border-white/10 pt-8 sm:flex-row sm:items-center sm:justify-between">
      <span>© 2026 Liam Kinnally · Orlando, FL</span>
      <span>Built with Astro · TypeScript · Tailwind CSS · Canvas · Vercel</span>
    </div>
  </footer>

  <script>
    const headings = document.querySelectorAll<HTMLElement>('[data-scroll-heading]');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (reducedMotion || !('IntersectionObserver' in window)) {
      headings.forEach((heading) => heading.classList.add('is-visible'));
    } else {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        },
        {
          threshold: 0.45,
          rootMargin: '0px 0px -8% 0px',
        },
      );

      headings.forEach((heading) => observer.observe(heading));
    }
  </script>

  <script>
    const user = 'lkinnally';
    const domain = 'hotmail.com';
    const address = `${user}@${domain}`;

    const emailLinks = document.querySelectorAll<HTMLAnchorElement>('[data-email-link]');
    emailLinks.forEach((link) => {
      link.setAttribute('href', `mailto:${address}`);
    });

    const copyButtons = document.querySelectorAll<HTMLButtonElement>('[data-copy-email]');
    copyButtons.forEach((button) => {
      const feedback = button.parentElement?.querySelector<HTMLElement>('[data-copy-feedback]');
      let feedbackTimer: number | undefined;

      button.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(address);
        } catch {
          const textarea = document.createElement('textarea');
          textarea.value = address;
          textarea.setAttribute('readonly', '');
          textarea.style.position = 'fixed';
          textarea.style.opacity = '0';
          document.body.appendChild(textarea);
          textarea.select();
          document.execCommand('copy');
          textarea.remove();
        }

        button.setAttribute('aria-label', 'Email address copied');
        if (feedback) {
          feedback.classList.remove('opacity-0');
          feedback.classList.add('opacity-100');
        }

        if (feedbackTimer !== undefined) window.clearTimeout(feedbackTimer);
        feedbackTimer = window.setTimeout(() => {
          button.setAttribute('aria-label', 'Copy Liam Kinnally email address');
          if (feedback) {
            feedback.classList.remove('opacity-100');
            feedback.classList.add('opacity-0');
          }
        }, 1600);
      });
    });
  </script>
</BaseLayout>
