---
interface Props {
  value: string;
  label: string;
  detail?: string;
}
const { value, label, detail } = Astro.props;
---
<div class="metric-card rounded-xl p-4">
  <div class="text-2xl font-bold tracking-tight text-white">{value}</div>
  <div class="mt-1 text-xs font-semibold uppercase tracking-[0.12em] text-slate-400">{label}</div>
  {detail && <div class="mt-2 text-xs leading-relaxed text-slate-500">{detail}</div>}
</div>
