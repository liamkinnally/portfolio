<span
  id="presence-indicator"
  class="presence-indicator inline-flex"
  data-state="loading"
  aria-live="polite"
  aria-label="Presence status"
>
  <span class="presence-dot" aria-hidden="true"></span>
  <span class="presence-label">Status</span>
</span>

<script>
  const indicator = document.querySelector<HTMLElement>('#presence-indicator');
  const label = indicator?.querySelector<HTMLElement>('.presence-label');
  const labels: Record<string, string> = {
    online: 'Online',
    away: 'Away',
    busy: 'Busy',
    offline: 'Offline',
  };

  const refreshPresence = async () => {
    if (!indicator || !label) return;

    try {
      const response = await fetch('/api/presence', { cache: 'no-store' });
      if (!response.ok) throw new Error('presence unavailable');

      const data = await response.json();
      const status = typeof data?.status === 'string' ? data.status : 'offline';
      const statusLabel = labels[status] ?? 'Offline';

      indicator.dataset.state = status;
      label.textContent = statusLabel;
      indicator.setAttribute('aria-label', `Presence status: ${statusLabel}`);
      indicator.classList.remove('presence-hidden');
    } catch {
      indicator.classList.add('presence-hidden');
    }
  };

  refreshPresence();
  window.setInterval(refreshPresence, 60_000);
</script>

<style>
  .presence-indicator {
    position: relative;
    top: 1px;
    align-items: center;
    gap: 0;
    min-width: 0.42rem;
    color: var(--muted-soft);
    font-size: 0.76rem;
    font-weight: 620;
    letter-spacing: -0.01em;
    transition: opacity 160ms ease, color 160ms ease;
  }

  .presence-label {
    display: none;
  }

  .presence-indicator[data-state="loading"],
  .presence-hidden {
    opacity: 0;
    pointer-events: none;
  }

  .presence-dot {
    width: 0.42rem;
    height: 0.42rem;
    flex: 0 0 0.42rem;
    border-radius: 999px;
    background: #7d8796;
    box-shadow: 0 0 0 3px rgba(102, 113, 128, 0.08);
  }

  .presence-indicator[data-state="online"] .presence-dot {
    background: #63c990;
    box-shadow: 0 0 0 3px rgba(99, 201, 144, 0.09), 0 0 14px rgba(99, 201, 144, 0.20);
  }

  .presence-indicator[data-state="away"] .presence-dot {
    background: #d7a956;
    box-shadow: 0 0 0 3px rgba(215, 169, 86, 0.09);
  }

  .presence-indicator[data-state="busy"] .presence-dot {
    background: #db788c;
    box-shadow: 0 0 0 3px rgba(219, 120, 140, 0.09);
  }

  @media (min-width: 640px) {
    .presence-indicator {
      gap: 0.45rem;
      min-width: 4.8rem;
    }

    .presence-label {
      display: inline;
    }
  }
</style>
