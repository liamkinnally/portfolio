---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found — Liam Kinnally"
  description="The page you were looking for could not be found."
>
  <section class="container-shell flex min-h-screen items-center pt-24 pb-20">
    <div class="max-w-2xl">
      <div class="eyebrow">404</div>
      <h1 class="gradient-text mt-6 text-5xl font-[780] tracking-[-0.05em] sm:text-6xl">That page isn’t here.</h1>
      <p class="mt-6 text-lg leading-8 text-slate-300">The link may have moved, or the page may not exist yet.</p>
      <a href="/" class="button-primary mt-8">Back to portfolio →</a>
    </div>
  </section>
</BaseLayout>
