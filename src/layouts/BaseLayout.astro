---
import '../styles/global.css';
import '../styles/theme-overrides.css';
import '../styles/skill-interactions.css';
import '../styles/heading-interactions.css';
import Header from '../components/Header.astro';
import ParticleCanvas from '../components/ParticleCanvas.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Liam Kinnally — Software Engineering, QA & AI/ML',
  description = 'Portfolio of Liam Kinnally, an Information Technology student at UCF focused on software engineering, software QA, and AI/ML.',
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <script is:inline>
      (() => {
        let theme = 'dark';
        try {
          if (localStorage.getItem('theme') === 'light') theme = 'light';
        } catch {}
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#07090d" />
    <meta name="robots" content="index, follow" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Liam Kinnally" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        const meta = document.querySelector('meta[name="theme-color"]');
        if (meta && document.documentElement.dataset.theme === 'light') {
          meta.setAttribute('content', '#f7f9fd');
        }
      })();
    </script>
  </head>
  <body>
    <ParticleCanvas />
    <Header />
    <main class="relative z-10">
      <slot />
    </main>

    <script>
      const coarsePointer = window.matchMedia('(hover: none) and (pointer: coarse)').matches;
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (coarsePointer && !reducedMotion && 'IntersectionObserver' in window) {
        const selectors = [
          '#work .metric-card',
          '#work .kbd-tag',
          '#skills .kbd-tag',
          '#education .kbd-tag',
          '.chart-shell--compact .interactive-pill',
          '.project-page .metric-card',
          '.project-page .stationary-highlight',
          '.project-page .interactive-pill',
        ];

        const initiallyHighlightedSelectors = [
          '.availability-pill.interactive-pill',
          '.project-page header .kbd-tag',
        ];

        const targets = document.querySelectorAll<HTMLElement>(
          [...selectors, ...initiallyHighlightedSelectors].join(','),
        );
        targets.forEach((target) => target.classList.add('mobile-scroll-focus'));

        const initiallyHighlighted = document.querySelectorAll<HTMLElement>(
          initiallyHighlightedSelectors.join(','),
        );
        initiallyHighlighted.forEach((target) => {
          target.dataset.mobileRevealTriggered = 'true';
        });

        const activeTargets = new Set<HTMLElement>();
        let releaseFrame = 0;

        const releasePassedHighlights = () => {
          releaseFrame = 0;
          const releaseLine = window.innerHeight * 0.20;

          for (const target of activeTargets) {
            const rect = target.getBoundingClientRect();
            const center = rect.top + rect.height / 2;

            if (center > releaseLine) continue;

            target.classList.remove('mobile-scroll-active');
            activeTargets.delete(target);
          }
        };

        const scheduleReleaseCheck = () => {
          if (releaseFrame) return;
          releaseFrame = window.requestAnimationFrame(releasePassedHighlights);
        };

        const startObserver = () => {
          initiallyHighlighted.forEach((target) => {
            target.classList.add('mobile-scroll-active');
            activeTargets.add(target);
          });

          document
            .querySelectorAll<HTMLElement>('.mobile-initial-highlight')
            .forEach((target) => target.classList.remove('mobile-initial-highlight'));
          document
            .querySelectorAll<HTMLElement>('.mobile-initial-highlight-group')
            .forEach((target) => target.classList.remove('mobile-initial-highlight-group'));

          const observer = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (!entry.isIntersecting || entry.intersectionRatio < 0.48) continue;

                const target = entry.target as HTMLElement;
                if (target.dataset.mobileRevealTriggered === 'true') continue;

                target.dataset.mobileRevealTriggered = 'true';
                target.classList.add('mobile-scroll-active');
                activeTargets.add(target);
                observer.unobserve(target);
                scheduleReleaseCheck();
              }
            },
            {
              threshold: [0.48],
              rootMargin: '0px 0px -8% 0px',
            },
          );

          targets.forEach((target) => {
            if (target.dataset.mobileRevealTriggered !== 'true') observer.observe(target);
          });

          window.addEventListener('scroll', scheduleReleaseCheck, { passive: true });
          scheduleReleaseCheck();
        };

        window.addEventListener('scroll', startObserver, { once: true, passive: true });
      }
    </script>
  </body>
</html>
