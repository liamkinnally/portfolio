---
import BaseLayout from '../layouts/BaseLayout.astro';
import MetricCard from '../components/MetricCard.astro';
import RollingMaeChart from '../components/RollingMaeChart.astro';
---

<BaseLayout>
  <section class="container-shell flex min-h-[92vh] items-center pt-28 pb-20">
    <div class="fade-up max-w-4xl">
      <div class="eyebrow">UCF · B.S. in Information Technology · CECS</div>
      <h1
        class="scroll-heading-shine gradient-text mt-7 text-6xl font-[790] leading-[0.94] tracking-[-0.06em] sm:text-7xl md:text-8xl lg:text-[6.4rem]"
        data-scroll-heading
        data-shine-text="Liam Kinnally"
      >
        Liam Kinnally
      </h1>
      <p class="mt-6 text-lg font-semibold tracking-[-0.015em] text-blue-200 sm:text-xl">
        Software Engineering · Testing / QA · AI / ML
      </p>
      <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-300 sm:text-xl">
        I build reliable software and data-driven systems, with an emphasis on testing, reproducibility, and measurable results.
      </p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a href="#work" class="button-primary">View projects <span aria-hidden="true">↓</span></a>
        <a href="https://github.com/liamkinnally" target="_blank" rel="noreferrer" class="button-secondary">GitHub ↗</a>
        <a href="https://www.linkedin.com/in/liamkinnally" target="_blank" rel="noreferrer" class="button-secondary">LinkedIn ↗</a>
      </div>
      <div class="mt-8">
        <span class="availability-pill">Open to 2027 internship opportunities</span>
      </div>
    </div>
  </section>

  <section id="work" class="container-shell scroll-mt-24 py-24">
    <div class="mb-10 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <div class="eyebrow">Featured project</div>
        <h2
          class="scroll-heading-shine mt-4 text-3xl font-bold tracking-[-0.035em] sm:text-4xl"
          data-scroll-heading
          data-shine-text="NBA Player Stat Prediction"
        >NBA Player Stat Prediction</h2>
      </div>
      <div class="flex gap-5 text-sm font-semibold">
        <a href="/projects/nba-scoring-model" class="text-blue-200 transition hover:text-white">Explore project →</a>
        <a href="https://github.com/liamkinnally/nba-scoring-model" target="_blank" rel="noreferrer" class="text-slate-300 transition hover:text-white">Source ↗</a>
      </div>
    </div>

    <article class="glass-card overflow-hidden rounded-2xl">
      <div class="grid lg:grid-cols-[1.05fr_0.95fr]">
        <div class="p-6 sm:p-8 lg:p-10">
          <div class="flex flex-wrap gap-2">
            <span class="kbd-tag">Python</span>
            <span class="kbd-tag">scikit-learn</span>
            <span class="kbd-tag">SQLAlchemy</span>
            <span class="kbd-tag">pytest</span>
            <span class="kbd-tag">GitHub Actions</span>
          </div>

          <h3 class="mt-7 max-w-xl text-2xl font-bold tracking-[-0.03em] sm:text-3xl">A reproducible ML pipeline for predicting NBA player performance.</h3>
          <p class="mt-4 max-w-2xl text-[1.02rem] leading-8 text-slate-300">
            Built an end-to-end data pipeline, leakage-safe feature engineering, chronological model evaluation, serialized artifacts, and automated tests around real NBA player-game data.
          </p>

          <div class="mt-8 grid gap-3 sm:grid-cols-3">
            <MetricCard value="26,547" label="Player-games" />
            <MetricCard value="4.85" label="Points MAE" />
            <MetricCard value="23 / 28" label="Windows won" detail="vs. 10-game rolling baseline" />
          </div>

          <div class="mt-8 flex flex-wrap gap-3">
            <a href="/projects/nba-scoring-model" class="button-primary">Explore project →</a>
            <a href="https://github.com/liamkinnally/nba-scoring-model" target="_blank" rel="noreferrer" class="button-secondary">View repository ↗</a>
          </div>
        </div>

        <div class="relative flex min-h-[390px] items-center overflow-hidden border-t border-white/[0.07] bg-[#090d15] p-4 sm:p-6 lg:border-t-0 lg:border-l lg:p-7">
          <div class="absolute inset-0 bg-[radial-gradient(circle_at_70%_20%,rgba(86,122,255,0.13),transparent_48%)]"></div>
          <div class="relative w-full">
            <RollingMaeChart compact />
          </div>
        </div>
      </div>
    </article>
  </section>

  <section class="container-shell py-10">
    <hr class="section-rule" />
  </section>

  <section id="skills" class="container-shell scroll-mt-24 py-24">
    <div class="max-w-2xl">
      <div class="eyebrow">Skills</div>
      <h2
        class="scroll-heading-shine mt-4 text-3xl font-bold tracking-[-0.035em] sm:text-4xl"
        data-scroll-heading
        data-shine-text="What I work with."
      >What I work with.</h2>
      <p class="mt-4 text-[1.02rem] leading-8 text-slate-300">
        My strongest work is in Python and software/data tooling, with growing frontend experience through this portfolio and other projects.
      </p>
    </div>

    <div class="mt-10 grid gap-4 md:grid-cols-2">
      <div class="glass-card rounded-2xl p-6">
        <div class="text-sm font-semibold text-blue-200">Languages</div>
        <div class="mt-4 flex flex-wrap gap-2">
          <span class="kbd-tag">Python</span><span class="kbd-tag">C</span><span class="kbd-tag">Java</span><span class="kbd-tag">SQL</span><span class="kbd-tag">TypeScript</span>
        </div>
      </div>

      <div class="glass-card rounded-2xl p-6">
        <div class="text-sm font-semibold text-blue-200">Testing & development</div>
        <div class="mt-4 flex flex-wrap gap-2">
          <span class="kbd-tag">pytest</span><span class="kbd-tag">GitHub Actions</span><span class="kbd-tag">Git</span><span class="kbd-tag">CI/CD</span><span class="kbd-tag">Bash</span><span class="kbd-tag">VS Code</span>
        </div>
      </div>

      <div class="glass-card rounded-2xl p-6">
        <div class="text-sm font-semibold text-blue-200">Data science & databases</div>
        <div class="mt-4 flex flex-wrap gap-2">
          <span class="kbd-tag">pandas</span><span class="kbd-tag">NumPy</span><span class="kbd-tag">scikit-learn</span><span class="kbd-tag">SQLAlchemy</span><span class="kbd-tag">SQLite</span><span class="kbd-tag">MySQL</span><span class="kbd-tag">Matplotlib</span>
        </div>
      </div>

      <div class="glass-card rounded-2xl p-6">
        <div class="text-sm font-semibold text-blue-200">Web & deployment</div>
        <div class="mt-4 flex flex-wrap gap-2">
          <span class="kbd-tag">Astro</span><span class="kbd-tag">Tailwind CSS</span><span class="kbd-tag">HTML / CSS</span><span class="kbd-tag">Vercel</span>
        </div>
      </div>
    </div>
  </section>

  <section class="container-shell py-10">
    <hr class="section-rule" />
  </section>

  <section id="education" class="container-shell scroll-mt-24 py-24">
    <div class="grid gap-10 lg:grid-cols-[0.7fr_1.3fr]">
      <div>
        <div class="eyebrow">Education</div>
        <h2
          class="scroll-heading-shine mt-4 text-3xl font-bold tracking-[-0.035em]"
          data-scroll-heading
          data-shine-text="University of Central Florida"
        >University of Central Florida</h2>
      </div>
      <div class="glass-card rounded-2xl p-6 sm:p-8">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
          <div>
            <h3 class="text-xl font-bold tracking-[-0.025em]">B.S. in Information Technology</h3>
            <p class="mt-2 text-slate-300">College of Engineering & Computer Science</p>
          </div>
          <div class="text-sm font-semibold text-blue-200">Expected August 2027</div>
        </div>
        <p class="mt-6 leading-7 text-slate-300">Dean’s List (Fall 2025) · President’s Honor Roll (Spring 2026)</p>
        <div class="mt-6">
          <div class="text-xs font-bold uppercase tracking-[0.14em] text-slate-400">Relevant coursework</div>
          <div class="mt-3 flex flex-wrap gap-2">
            <span class="kbd-tag">Data Structures & Algorithms</span>
            <span class="kbd-tag">Discrete Mathematics</span>
            <span class="kbd-tag">Object-Oriented Programming (Java)</span>
            <span class="kbd-tag">Computer Architecture Concepts (Digital Logic & Assembly)</span>
            <span class="kbd-tag">Database Concepts (SQL & Database Connectivity)</span>
            <span class="kbd-tag">Secure Software Development</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="container-shell py-10">
    <hr class="section-rule" />
  </section>

  <section id="about" class="container-shell scroll-mt-24 py-24">
    <div class="grid gap-10 lg:grid-cols-[0.75fr_1.25fr]">
      <div>
        <div class="eyebrow">About</div>
        <h2
          class="scroll-heading-shine mt-4 text-3xl font-bold tracking-[-0.035em]"
          data-scroll-heading
          data-shine-text="I like software that can prove it works."
        >I like software that can prove it works.</h2>
      </div>
      <div class="max-w-2xl space-y-5 text-[1.05rem] leading-8 text-slate-300">
        <p>
          I’m an Information Technology student at UCF interested in software engineering, testing, and applied machine learning. I enjoy projects where correctness can be measured — whether that means building a data pipeline, designing tests, or turning raw information into something useful.
        </p>
        <p>
          Outside of software, I’m usually following basketball, enjoying competitive strategy games, or fixating on the newest engineering developments in performance cars. I’m especially drawn to projects that connect software with the areas I’m most passionate about.
        </p>
      </div>
    </div>
  </section>

  <section id="contact" class="container-shell scroll-mt-24 py-24">
    <div class="rounded-2xl border border-blue-200/10 bg-blue-200/[0.035] p-7 sm:p-10">
      <div class="eyebrow">Contact</div>
      <div class="mt-5 grid gap-8 lg:grid-cols-[1fr_auto] lg:items-end">
        <div class="max-w-2xl">
          <h2
            class="scroll-heading-shine text-3xl font-bold tracking-[-0.04em] sm:text-4xl"
            data-scroll-heading
            data-shine-text="Let’s build something."
          >Let’s build something.</h2>
          <p class="mt-4 text-[1.02rem] leading-8 text-slate-300">
            I’m currently pursuing software engineering, software testing/QA, and related internship opportunities.
          </p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href="https://www.linkedin.com/in/liamkinnally" target="_blank" rel="noreferrer" class="button-primary">LinkedIn ↗</a>
          <a href="https://github.com/liamkinnally" target="_blank" rel="noreferrer" class="button-secondary">GitHub ↗</a>
        </div>
      </div>
    </div>
  </section>

  <footer class="container-shell py-10">
    <hr class="section-rule" />
    <div class="flex flex-col gap-3 py-8 text-sm text-slate-400 sm:flex-row sm:items-center sm:justify-between">
      <span>© 2026 Liam Kinnally</span>
      <span>Built with Astro · TypeScript · Tailwind CSS · Canvas · Vercel</span>
    </div>
  </footer>

  <script>
    const headings = document.querySelectorAll<HTMLElement>('[data-scroll-heading]');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (reducedMotion || !('IntersectionObserver' in window)) {
      headings.forEach((heading) => heading.classList.add('is-visible'));
    } else {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        },
        {
          threshold: 0.45,
          rootMargin: '0px 0px -8% 0px',
        },
      );

      headings.forEach((heading) => observer.observe(heading));
    }
  </script>
</BaseLayout>
