---
import '../styles/global.css';
import '../styles/theme-overrides.css';
import '../styles/skill-interactions.css';
import '../styles/heading-interactions.css';
import Header from '../components/Header.astro';
import ParticleCanvas from '../components/ParticleCanvas.astro';
import SpeedInsights from '@vercel/speed-insights/astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Liam Kinnally — Software Engineering, QA & AI/ML',
  description = 'Portfolio of Liam Kinnally, an Information Technology student at UCF focused on software engineering, software QA, and AI/ML.',
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <script is:inline>
      (() => {
        let theme = 'dark';
        try {
          if (localStorage.getItem('theme') === 'light') theme = 'light';
        } catch {}
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#07090d" />
    <meta name="robots" content="index, follow" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Liam Kinnally" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        const meta = document.querySelector('meta[name="theme-color"]');
        if (meta && document.documentElement.dataset.theme === 'light') {
          meta.setAttribute('content', '#f7f9fd');
        }
      })();
    </script>
  </head>
  <body>
    <ParticleCanvas />
    <Header />
    <main class="relative z-10">
      <slot />
    </main>
    <SpeedInsights />

    <script>
      const coarsePointer = window.matchMedia('(hover: none) and (pointer: coarse)').matches;
      const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (coarsePointer && !reducedMotion) {
        const selectors = [
          '.availability-pill.interactive-pill',
          '.scroll-frame-focus',
          '#work .metric-card',
          '#work .kbd-tag',
          '#skills .kbd-tag',
          '#education .kbd-tag',
          '.chart-shell--compact .interactive-pill',
          '.project-page .metric-card',
          '.project-page .stationary-highlight',
          '.project-page .interactive-pill',
        ];

        const initiallyHighlightedSelectors = [
          '.project-page header .kbd-tag',
        ];

        const targets = Array.from(
          document.querySelectorAll<HTMLElement>(
            [...selectors, ...initiallyHighlightedSelectors].join(','),
          ),
        );
        targets.forEach((target) => target.classList.add('mobile-scroll-focus'));

        const initialTargets = new Set(
          Array.from(
            document.querySelectorAll<HTMLElement>(initiallyHighlightedSelectors.join(',')),
          ),
        );

        let scrollFrame = 0;

        const clamp01 = (value: number) => Math.min(1, Math.max(0, value));
        const smoothstep = (value: number) => {
          const t = clamp01(value);
          return t * t * (3 - 2 * t);
        };

        const getViewportMotion = () => {
          const viewport = window.visualViewport;
          const viewportTop = viewport?.offsetTop ?? 0;
          const viewportHeight = viewport?.height ?? window.innerHeight;

          return {
            entryLine: viewportTop + viewportHeight * 0.80,
            releaseLine: viewportTop + viewportHeight * 0.20,
            viewportHeight,
          };
        };

        const getInlineBloomDistance = (viewportHeight: number, elementHeight: number) =>
          Math.min(
            118,
            Math.max(
              62,
              viewportHeight * 0.075 + Math.min(elementHeight, 180) * 0.24,
            ),
          );

        const getSystemStepBloomDistance = (
          viewportHeight: number,
          elementHeight: number,
        ) =>
          Math.min(
            126,
            Math.max(
              94,
              viewportHeight * 0.07 + Math.min(elementHeight, 150) * 0.26,
            ),
          );

        const getBloomDistance = (
          viewportHeight: number,
          elementHeight: number,
          target: HTMLElement,
        ) => {
          if (target.classList.contains('scroll-frame-focus')) {
            // A frame containing several nested frames is the System Design card.
            // Let its trace span the actual child layout, then complete just after
            // the final step card rather than finishing near the first row.
            const nestedFrames = Array.from(
              target.querySelectorAll<HTMLElement>('.scroll-frame-focus'),
            );

            if (nestedFrames.length >= 5) {
              const frameRect = target.getBoundingClientRect();
              const lastStepCompletion = Math.max(
                ...nestedFrames.map((step) => {
                  const stepRect = step.getBoundingClientRect();
                  const stepTopOffset = stepRect.top - frameRect.top;
                  return (
                    stepTopOffset +
                    getSystemStepBloomDistance(viewportHeight, stepRect.height)
                  );
                }),
              );
              const frameTail = Math.max(
                26,
                Math.min(44, elementHeight * 0.055),
              );

              return Math.min(
                620,
                Math.max(180, lastStepCompletion + frameTail),
              );
            }

            // Step cards inside System Design get a slightly longer local draw
            // distance than generic quiet cards, so each reveal feels deliberate.
            const parentFrame = target.parentElement?.closest<HTMLElement>('.scroll-frame-focus');
            if (
              parentFrame &&
              parentFrame.querySelectorAll('.scroll-frame-focus').length >= 5
            ) {
              return getSystemStepBloomDistance(viewportHeight, elementHeight);
            }

            // Chart shells are nested interactions: derive the frame distance from
            // the actual pill position(s), so the frame starts first and completes
            // just after the final pill regardless of wrapping or screen size.
            if (target.classList.contains('chart-shell')) {
              const frameRect = target.getBoundingClientRect();
              const pills = Array.from(
                target.querySelectorAll<HTMLElement>('.interactive-pill'),
              );

              if (pills.length) {
                const lastPillCompletion = Math.max(
                  ...pills.map((pill) => {
                    const pillRect = pill.getBoundingClientRect();
                    const pillCenterOffset =
                      pillRect.top + pillRect.height / 2 - frameRect.top;
                    return (
                      pillCenterOffset +
                      getInlineBloomDistance(viewportHeight, pillRect.height)
                    );
                  }),
                );
                const frameTail = Math.max(
                  22,
                  Math.min(38, elementHeight * 0.055),
                );

                return Math.min(
                  280,
                  Math.max(112, lastPillCompletion + frameTail),
                );
              }
            }

            const animatedChildCount = target.querySelectorAll(
              '.kbd-tag, .metric-card, .interactive-pill',
            ).length;
            const contentAwareDistance =
              viewportHeight * 0.085 +
              Math.min(elementHeight, 560) * 0.22 +
              Math.min(animatedChildCount, 10) * 16;

            if (target.classList.contains('scroll-frame-quiet')) {
              return Math.min(175, Math.max(84, contentAwareDistance * 0.72));
            }

            return Math.min(380, Math.max(112, contentAwareDistance));
          }

          return getInlineBloomDistance(viewportHeight, elementHeight);
        };

        const setBloom = (
          target: HTMLElement,
          strength: number,
          phase: 'entry' | 'active' | 'exit',
        ) => {
          const rawProgress = clamp01(strength);
          const borderProgress = smoothstep(rawProgress);
          const surfaceProgress = smoothstep(clamp01((rawProgress - 0.12) / 0.88));
          let clipTop = 0;
          let clipBottom = 0;

          if (phase === 'entry') {
            clipBottom = (1 - borderProgress) * 100;
          } else if (phase === 'exit') {
            clipTop = (1 - borderProgress) * 100;
          }

          target.style.setProperty('--mobile-bloom-strength', borderProgress.toFixed(4));
          target.style.setProperty('--mobile-surface-strength', surfaceProgress.toFixed(4));
          target.style.setProperty('--mobile-bloom-clip-top', `${clipTop.toFixed(2)}%`);
          target.style.setProperty('--mobile-bloom-clip-bottom', `${clipBottom.toFixed(2)}%`);
          target.classList.toggle('mobile-scroll-colored', surfaceProgress > 0.44);
        };

        const updateScrollHighlights = () => {
          scrollFrame = 0;
          const { entryLine, releaseLine, viewportHeight } = getViewportMotion();

          for (const target of targets) {
            const rect = target.getBoundingClientRect();
            const center = rect.top + rect.height / 2;
            const isFrame = target.classList.contains('scroll-frame-focus');
            const isChartFrame = isFrame && target.classList.contains('chart-shell');
            const isLeafFrame = isFrame && target.classList.contains('scroll-frame-leaf');
            const entryAnchor = isFrame ? rect.top : center;
            // Chart frames and small leaf cards release from the top edge so
            // their border visibly unwinds as the element leaves the viewport.
            const releaseAnchor = isChartFrame || isLeafFrame
              ? rect.top
              : isFrame
                ? rect.bottom
                : center;
            const bloomDistance = getBloomDistance(viewportHeight, rect.height, target);

            // Project-page hero stack pills deliberately begin fully highlighted.
            // They only participate in the scroll-mapped release at the upper boundary.
            if (initialTargets.has(target)) {
              if (center > releaseLine) {
                setBloom(target, 1, 'active');
              } else {
                const exitProgress = clamp01((releaseLine - center) / bloomDistance);
                setBloom(target, 1 - exitProgress, 'exit');
              }
              continue;
            }

            if (entryAnchor > entryLine) {
              setBloom(target, 0, 'entry');
              continue;
            }

            const entryEnd = entryLine - bloomDistance;
            if (entryAnchor > entryEnd) {
              const entryProgress = clamp01((entryLine - entryAnchor) / bloomDistance);
              setBloom(target, entryProgress, 'entry');
              continue;
            }

            if (releaseAnchor > releaseLine) {
              setBloom(target, 1, 'active');
              continue;
            }

            const exitProgress = clamp01((releaseLine - releaseAnchor) / bloomDistance);
            setBloom(target, 1 - exitProgress, 'exit');
          }
        };

        const scheduleScrollUpdate = () => {
          if (scrollFrame) return;
          scrollFrame = window.requestAnimationFrame(updateScrollHighlights);
        };

        const startTracking = () => {
          // Establish the scroll-driven visual state before removing the
          // first-frame project-stack highlight class so there is no visible handoff.
          updateScrollHighlights();

          document
            .querySelectorAll<HTMLElement>('.mobile-initial-highlight-group')
            .forEach((target) => target.classList.remove('mobile-initial-highlight-group'));

          window.addEventListener('scroll', scheduleScrollUpdate, { passive: true });
          window.addEventListener('resize', scheduleScrollUpdate, { passive: true });
          window.visualViewport?.addEventListener('resize', scheduleScrollUpdate, { passive: true });
          window.visualViewport?.addEventListener('scroll', scheduleScrollUpdate, { passive: true });
          scheduleScrollUpdate();
        };

        window.addEventListener('scroll', startTracking, { once: true, passive: true });
      }

      if (finePointer && !reducedMotion) {
        const desktopFrames = Array.from(
          document.querySelectorAll<HTMLElement>('.scroll-frame-major'),
        );
        desktopFrames.forEach((target) => target.classList.add('desktop-scroll-frame'));

        let desktopScrollFrame = 0;
        const clampDesktop = (value: number) => Math.min(1, Math.max(0, value));
        const smoothDesktop = (value: number) => {
          const t = clampDesktop(value);
          return t * t * (3 - 2 * t);
        };

        const setDesktopFrame = (
          target: HTMLElement,
          strength: number,
          phase: 'entry' | 'active' | 'exit',
        ) => {
          const progress = smoothDesktop(strength);
          let clipTop = 0;
          let clipBottom = 0;

          if (phase === 'entry') {
            clipBottom = (1 - progress) * 100;
          } else if (phase === 'exit') {
            clipTop = (1 - progress) * 100;
          }

          target.style.setProperty('--desktop-frame-strength', progress.toFixed(4));
          target.style.setProperty('--desktop-frame-clip-top', `${clipTop.toFixed(2)}%`);
          target.style.setProperty('--desktop-frame-clip-bottom', `${clipBottom.toFixed(2)}%`);
        };

        const updateDesktopFrames = () => {
          desktopScrollFrame = 0;
          const viewportHeight = window.innerHeight;
          const entryLine = viewportHeight * 0.86;
          const releaseLine = viewportHeight * 0.14;

          for (const target of desktopFrames) {
            const rect = target.getBoundingClientRect();
            const drawDistance = Math.min(
              260,
              Math.max(
                150,
                viewportHeight * 0.11 + Math.min(rect.height, 520) * 0.16,
              ),
            );

            if (rect.top > entryLine) {
              setDesktopFrame(target, 0, 'entry');
              continue;
            }

            const entryEnd = entryLine - drawDistance;
            if (rect.top > entryEnd) {
              const progress = clampDesktop((entryLine - rect.top) / drawDistance);
              setDesktopFrame(target, progress, 'entry');
              continue;
            }

            if (rect.bottom > releaseLine) {
              setDesktopFrame(target, 1, 'active');
              continue;
            }

            const exitProgress = clampDesktop((releaseLine - rect.bottom) / drawDistance);
            setDesktopFrame(target, 1 - exitProgress, 'exit');
          }
        };

        const scheduleDesktopUpdate = () => {
          if (desktopScrollFrame) return;
          desktopScrollFrame = window.requestAnimationFrame(updateDesktopFrames);
        };

        window.addEventListener('scroll', scheduleDesktopUpdate, { passive: true });
        window.addEventListener('resize', scheduleDesktopUpdate, { passive: true });
        updateDesktopFrames();
      }
    </script>
  </body>
</html>
