---
import '../styles/global.css';
import Header from '../components/Header.astro';
import ParticleCanvas from '../components/ParticleCanvas.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Liam Kinnally — Software Engineering, QA & AI/ML',
  description = 'Portfolio of Liam Kinnally, an Information Technology student at UCF focused on software engineering, software QA, and AI/ML.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#07090d" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <ParticleCanvas />
    <Header />
    <main class="relative z-10">
      <slot />
    </main>
  </body>
</html>
