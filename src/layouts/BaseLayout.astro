---
import '../styles/global.css';
import '../styles/theme-overrides.css';
import '../styles/skill-interactions.css';
import '../styles/heading-interactions.css';
import Header from '../components/Header.astro';
import ParticleCanvas from '../components/ParticleCanvas.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Liam Kinnally — Software Engineering, QA & AI/ML',
  description = 'Portfolio of Liam Kinnally, an Information Technology student at UCF focused on software engineering, software QA, and AI/ML.',
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <script is:inline>
      (() => {
        let theme = 'dark';
        try {
          if (localStorage.getItem('theme') === 'light') theme = 'light';
        } catch {}
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#07090d" />
    <meta name="robots" content="index, follow" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Liam Kinnally" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        const meta = document.querySelector('meta[name="theme-color"]');
        if (meta && document.documentElement.dataset.theme === 'light') {
          meta.setAttribute('content', '#f7f9fd');
        }
      })();
    </script>
  </head>
  <body>
    <ParticleCanvas />
    <Header />
    <main class="relative z-10">
      <slot />
    </main>

    <script>
      const coarsePointer = window.matchMedia('(hover: none) and (pointer: coarse)').matches;
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (coarsePointer && !reducedMotion) {
        const selectors = [
          '#work .metric-card',
          '#work .kbd-tag',
          '#skills .kbd-tag',
          '#education .kbd-tag',
          '.chart-shell--compact .interactive-pill',
          '.project-page .metric-card',
          '.project-page .stationary-highlight',
          '.project-page .interactive-pill',
        ];

        const initiallyHighlightedSelectors = [
          '.availability-pill.interactive-pill',
          '.project-page header .kbd-tag',
        ];

        const targets = document.querySelectorAll<HTMLElement>(
          [...selectors, ...initiallyHighlightedSelectors].join(','),
        );
        targets.forEach((target) => target.classList.add('mobile-scroll-focus'));

        let scrollFrame = 0;

        const getViewportBand = () => {
          const viewport = window.visualViewport;
          const viewportTop = viewport?.offsetTop ?? 0;
          const viewportHeight = viewport?.height ?? window.innerHeight;

          return {
            entryLine: viewportTop + viewportHeight * 0.80,
            releaseLine: viewportTop + viewportHeight * 0.20,
          };
        };

        const clamp = (value: number) => Math.min(100, Math.max(0, value));

        const updateScrollHighlights = () => {
          scrollFrame = 0;
          const { entryLine, releaseLine } = getViewportBand();

          for (const target of targets) {
            const rect = target.getBoundingClientRect();
            const height = Math.max(rect.height, 1);
            const overlapTop = Math.max(rect.top, releaseLine);
            const overlapBottom = Math.min(rect.bottom, entryLine);

            if (overlapBottom <= overlapTop) {
              target.classList.remove('mobile-scroll-full');

              if (rect.top >= entryLine) {
                target.style.setProperty('--mobile-clip-top', '0%');
                target.style.setProperty('--mobile-clip-bottom', '100%');
              } else {
                target.style.setProperty('--mobile-clip-top', '100%');
                target.style.setProperty('--mobile-clip-bottom', '0%');
              }
              continue;
            }

            const clipTop = clamp(((overlapTop - rect.top) / height) * 100);
            const clipBottom = clamp(((rect.bottom - overlapBottom) / height) * 100);

            target.style.setProperty('--mobile-clip-top', `${clipTop}%`);
            target.style.setProperty('--mobile-clip-bottom', `${clipBottom}%`);

            const fullyInsideBand = clipTop <= 0.1 && clipBottom <= 0.1;
            target.classList.toggle('mobile-scroll-full', fullyInsideBand);
          }
        };

        const scheduleScrollUpdate = () => {
          if (scrollFrame) return;
          scrollFrame = window.requestAnimationFrame(updateScrollHighlights);
        };

        const startTracking = () => {
          document
            .querySelectorAll<HTMLElement>('.mobile-initial-highlight')
            .forEach((target) => target.classList.remove('mobile-initial-highlight'));
          document
            .querySelectorAll<HTMLElement>('.mobile-initial-highlight-group')
            .forEach((target) => target.classList.remove('mobile-initial-highlight-group'));

          window.addEventListener('scroll', scheduleScrollUpdate, { passive: true });
          window.addEventListener('resize', scheduleScrollUpdate, { passive: true });
          window.visualViewport?.addEventListener('resize', scheduleScrollUpdate, { passive: true });
          window.visualViewport?.addEventListener('scroll', scheduleScrollUpdate, { passive: true });
          scheduleScrollUpdate();
        };

        window.addEventListener('scroll', startTracking, { once: true, passive: true });
      }
    </script>
  </body>
</html>
